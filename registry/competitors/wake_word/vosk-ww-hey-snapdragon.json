{
  "competitor_id": "vosk-ww-hey-snapdragon",
  "modality": "wake_word",
  "plugin": "ovos-ww-plugin-vosk",
  "config": {
    "listener": {
      "wake_word": "hey_snapdragon"
    },
    "hotwords": {
      "hey_snapdragon": {
        "module": "ovos-ww-plugin-vosk",
        "listen": true,
        "model": "http://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip",
        "lang": "en-US",
        "samples": [
          "hey snapdragon"
        ],
        "full_vocab": false,
        "rule": "equals",
        "threshold": 0.75,
        "time_between_checks": 1.0,
        "debug": false
      }
    }
  },
  "langs": [
    "en-US",
    "en-GB",
    "en-AU"
  ],
  "display_name": "Vosk wake word (hey snapdragon)",
  "species": "VoskWakeWordPlugin",
  "types": [
    "neural-net",
    "keyword-match"
  ],
  "description": "Detects wake words by running the Vosk Kaldi recognizer in keyword mode and matching the transcript against configured samples.",
  "links": {
    "source": "https://github.com/OpenVoiceOS/ovos-ww-plugin-vosk"
  },
  "notes": "Samples ['hey snapdragon'] with the equals rule: the phrase itself, every word of which is in the model vocabulary. The language model is auto-downloaded.",
  "capabilities": [
    "clip",
    "stream"
  ]
}
