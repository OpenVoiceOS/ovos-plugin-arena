{
  "competitor_id": "microwakeword-hey-jarvis-silero-speaker",
  "modality": "wake_word",
  "plugin": "ovos-ww-plugin-microwakeword",
  "config": {
    "listener": {
      "wake_word": "hey_jarvis",
      "VAD": {
        "module": "ovos-vad-plugin-silero",
        "threshold": 0.5,
        "ovos-vad-plugin-silero": {
          "threshold": 0.5
        }
      }
    },
    "hotwords": {
      "hey_jarvis": {
        "module": "ovos-ww-plugin-microwakeword",
        "listen": true,
        "model": "https://github.com/esphome/micro-wake-word-models/raw/main/models/hey_jarvis.tflite",
        "model_name": "hey_jarvis",
        "model_version": 1,
        "probability_cutoff": 0.5,
        "sliding_window_size": 10,
        "refractory_frames": 40
      }
    },
    "hotword_verifier": {
      "module": "ovos-ww-verifier-speaker",
      "model": "wespeaker-resnet34",
      "threshold": 0.45,
      "fail_open": true,
      "per_profile_thresholds": {}
    }
  },
  "langs": [
    "en-US",
    "en-GB",
    "en-AU"
  ],
