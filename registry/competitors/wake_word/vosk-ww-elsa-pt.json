{
  "competitor_id": "vosk-ww-elsa-pt",
  "modality": "wake_word",
  "plugin": "ovos-ww-plugin-vosk",
  "config": {
    "listener": {
      "wake_word": "elsa"
    },
    "hotwords": {
      "elsa": {
        "module": "ovos-ww-plugin-vosk",
        "listen": true,
        "model": "https://alphacephei.com/vosk/models/vosk-model-small-pt-0.3.zip",
        "lang": "pt-PT",
        "samples": [
          "elsa"
        ],
        "full_vocab": false,
        "rule": "equals",
        "threshold": 0.75,
        "time_between_checks": 1.0,
        "debug": false
      }
    }
  },
  "langs": [
    "pt-PT"
  ],
  "display_name": "Vosk wake word (elsa)",
  "species": "VoskWakeWordPlugin",
  "types": [
    "neural-net",
    "keyword-match"
  ],
  "description": "Detects wake words by running the Vosk Kaldi recognizer in keyword mode and matching the transcript against configured samples.",
  "links": {
    "source": "https://github.com/OpenVoiceOS/ovos-ww-plugin-vosk"
  },
  "notes": "Samples ['elsa'] with the equals rule: the phrase itself, every word of which is in the model vocabulary. The language model is auto-downloaded.",
  "capabilities": [
    "clip",
    "stream"
  ]
}
