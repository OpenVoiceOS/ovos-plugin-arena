{
  "competitor_id": "openwakeword-hey-mycroft-silero-speaker",
  "modality": "wake_word",
  "plugin": "ovos-ww-plugin-openwakeword",
  "config": {
    "listener": {
      "wake_word": "hey_mycroft",
      "VAD": {
        "module": "ovos-vad-plugin-silero",
        "threshold": 0.5,
        "ovos-vad-plugin-silero": {
          "threshold": 0.5
        }
      }
    },
    "hotwords": {
      "hey_mycroft": {
        "module": "ovos-ww-plugin-openwakeword",
        "listen": true,
        "threshold": 0.5,
        "custom_verifier_models": {},
        "custom_verifier_threshold": 0.1
      }
    },
    "hotword_verifier": {
      "module": "ovos-ww-verifier-speaker",
      "model": "wespeaker-resnet34",
      "threshold": 0.45,
      "fail_open": true,
      "per_profile_thresholds": {}
    }
  },
  "langs": [
    "en"
  ],
  "display_name": "openWakeWord + Silero VAD + speaker verifier (hey mycroft)",
  "species": "OwwHotwordPlugin",
  "types": [
    "neural-net",
    "vad-gated",
    "verified"
  ],
  "description": "The full listener stack for 'hey mycroft': a Silero pre-wake VAD gate, then openWakeWord, then a speaker-verification confirm. Both gates push the false-accept rate down; the benchmark shows the false-reject cost.",
  "model": "silero-vad → hey_mycroft (openWakeWord) → speaker verifier",
  "links": {
    "source": "https://github.com/OpenVoiceOS/ovos-ww-plugin-openWakeWord"
  },
  "notes": "Combo fighter: pre-wake VAD + wake-word engine + verifier. Each distinct (engine, VAD, verifier) triple is its own competitor."
}
