{
  "competitor_id": "vosk-ww-hey-mycroft",
  "modality": "wake_word",
  "plugin": "ovos-ww-plugin-vosk",
  "config": {
    "listener": {
      "wake_word": "hey_mycroft"
    },
    "hotwords": {
      "hey_mycroft": {
        "module": "ovos-ww-plugin-vosk",
        "listen": true,
        "model": "http://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip",
        "lang": "en-US",
        "samples": [
          "hey mycroft",
          "hey microsoft",
          "hey mike roft",
          "hey minecraft"
        ],
        "full_vocab": false,
        "rule": "fuzzy",
        "threshold": 0.75,
        "time_between_checks": 1.0,
        "debug": false
      }
    }
  },
  "langs": [
    "en-US",
    "en-GB",
    "en-AU"
  ],
  "display_name": "Vosk wake word (hey mycroft)",
  "species": "VoskWakeWordPlugin",
  "types": [
    "neural-net",
    "keyword-match"
  ],
  "description": "Detects wake words by running the Vosk Kaldi recognizer in keyword mode and matching the transcript against configured samples.",
  "links": {
    "source": "https://github.com/OpenVoiceOS/ovos-ww-plugin-vosk"
  },
  "notes": "Samples ['hey mycroft', 'hey microsoft', 'hey mike roft', 'hey minecraft'] with the fuzzy rule: the hey_mycroft_vosk fallback that ovos-config ships (ovos_config/mycroft.conf). The language model is auto-downloaded.",
  "capabilities": [
    "clip",
    "stream"
  ]
}
