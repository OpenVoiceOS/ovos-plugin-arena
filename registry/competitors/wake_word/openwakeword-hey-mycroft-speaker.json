      "threshold": 0.45,
      "fail_open": true,
      "per_profile_thresholds": {}
    }
  },
  "langs": [
    "en"
  ],
  "display_name": "openWakeWord + speaker verifier (hey mycroft)",
  "species": "OwwHotwordPlugin",
  "types": [
    "neural-net",
    "verified"
  ],
  "description": "openWakeWord 'hey mycroft' followed by a speaker-verification gate: an activation only counts when the verifier confirms it, trading a small false-reject increase for fewer false-accepts.",
  "model": "hey_mycroft (openWakeWord) + speaker verifier",
  "links": {
    "source": "https://github.com/OpenVoiceOS/ovos-ww-plugin-openWakeWord"
