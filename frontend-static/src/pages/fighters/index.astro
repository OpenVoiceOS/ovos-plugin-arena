---
import Base from '../../layouts/Base.astro';
---
<Base title="Fighters" description="The fighter bestiary — every competitor in the arena, with species, types and stats.">
  <h1>Fighters</h1>
  <p>
    The arena bestiary. Every fighter is a <strong>shippable configuration</strong> declared as a
    JSON file in the <a href="https://github.com/OpenVoiceOS/ovos-plugin-arena/tree/dev/registry">registry</a> —
    a valid <code>mycroft.conf</code> fragment naming its pipeline stages. Its
    <strong>species</strong> is the plugin class it instantiates; its <strong>types</strong>
    describe the architecture doing the matching. Multi-stage pipelines are
    <strong>ensemble</strong> fighters in their own right.
  </p>

  <div class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin-bottom:1.5rem">
    <label for="sel-search" style="color:var(--muted);font-size:0.9rem">Search</label>
    <input id="sel-search" type="search" placeholder="Search fighters…"
           style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem;min-width:12rem" />
    <label for="sel-modality" style="color:var(--muted);font-size:0.9rem">Modality</label>
    <select id="sel-modality" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem">
      <option value="">All</option>
      <option value="stt">STT</option>
      <option value="tts">TTS</option>
      <option value="wake_word">Wake Word</option>
      <option value="vad">VAD</option>
      <option value="intent">Intent · Open</option>
      <option value="intent_template">Intent · Template</option>
      <option value="intent_keyword">Intent · Keyword</option>
    </select>
    <label for="sel-type" style="color:var(--muted);font-size:0.9rem">Type</label>
    <select id="sel-type" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem">
      <option value="">All</option>
    </select>
    <label for="sel-flang" style="color:var(--muted);font-size:0.9rem">Language</label>
    <select id="sel-flang" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem">
      <option value="">All</option>
    </select>
    <label for="chk-group-variants" style="color:var(--muted);font-size:0.9rem;cursor:pointer;display:flex;align-items:center;gap:0.35rem">
      <input type="checkbox" id="chk-group-variants" checked />
      <span>Group variants</span>
    </label>
    <button type="button" id="btn-reset-filters" class="btn" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.75rem;cursor:pointer">
      Reset filters
    </button>
    <span id="dex-count" style="color:var(--muted);font-size:0.85rem;margin-left:auto" aria-live="polite"></span>
  </div>

  <style>
    #dex-grid { justify-content: center; }
    .fighter {
      margin-bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      text-align: center;
      /* Thousands of cards can exist in the DOM at once (registry scale) —
         skip layout/paint for the ones currently off-screen. The intrinsic
         size is a rough estimate of a typical card's rendered height so
         scrollbar geometry doesn't jump around as cards come in/out of view. */
      content-visibility: auto;
      contain-intrinsic-size: 420px;
    }
    .fighter-hero { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; }
    .fighter-hero svg { filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.45)); }
    .fighter-hero h2 { margin: 0.2rem 0 0; font-size: 1.2rem; letter-spacing: -0.01em; }
    .fighter-types { display: flex; gap: 0.3rem; flex-wrap: wrap; justify-content: center; }
    .fighter-desc { font-size: 0.86rem; margin: 0; }
    .fighter-stats {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.3rem 0.8rem;
      font-size: 0.82rem;
      margin: 0;
      text-align: left;
      background: rgba(0, 0, 0, 0.22);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.7rem 0.9rem;
    }
    .fighter-stats dt { color: var(--muted); font-weight: 600; }
    .fighter-stats dd { margin: 0; font-family: var(--mono); word-break: break-word; }
    .fighter-foot { margin-top: auto; }

    /* ---- subspecies groups ---- */
    .fighter-group { display: contents; }
    .group-card {
      padding: 0; margin-bottom: 0; overflow: hidden;
      content-visibility: auto;
      contain-intrinsic-size: 260px;
    }
    .group-summary {
      cursor: pointer; list-style: none; padding: 1rem 1.1rem;
      display: flex; flex-direction: column; gap: 0.5rem; text-align: center;
    }
    .group-summary::-webkit-details-marker { display: none; }
    .group-summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .group-head { display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap; }
    .group-head h2 { margin: 0; font-size: 1.2rem; letter-spacing: -0.01em; }
    .group-count { font-family: var(--mono); font-size: 0.76rem; color: var(--muted);
      border: 1px solid var(--border); border-radius: 999px; padding: 0.1rem 0.55rem; }
    .group-meta { font-size: 0.8rem; color: var(--muted); }
    .group-toggle-hint { font-size: 0.76rem; color: var(--muted); }
    .group-details[open] .group-toggle-hint::before { content: '▾ hide variants'; }
    .group-details:not([open]) .group-toggle-hint::before { content: '▸ show variants'; }
    .group-members {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem; padding: 0 1.1rem 1.1rem;
    }
    .group-members .fighter { border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  </style>

  <div id="dex-loading" class="card" aria-live="polite">Loading fighters…</div>
  <div id="dex-empty" class="card" style="display:none">
    No fighters found. Run the <code>export-bestiary</code> CLI / the <code>assemble.yml</code> Action to generate <code>competitors.json</code>.
  </div>
  <div id="dex-filtered-empty" class="card" style="display:none">
    No fighters match these filters — reset or try another language.
  </div>
  <div id="dex-grid" style="display:none;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem"></div>

  <script>
    import { spriteSvg, TYPE_HUE } from '../../lib/sprite.js';
    import { langDisplayName } from '../../lib/lang.js';

    const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
    const MODALITY_LABELS = { stt: 'STT', tts: 'TTS', wake_word: 'Wake Word', vad: 'VAD', intent: 'Intent · Open', intent_template: 'Intent · Template', intent_keyword: 'Intent · Keyword', g2p: 'G2P' };
    const BADGE_CLASS = { stt: 'badge-stt', tts: 'badge-tts', wake_word: 'badge-ww', vad: 'badge-vad', intent: 'badge-intent', intent_template: 'badge-intent', intent_keyword: 'badge-intent', g2p: 'badge-g2p' };
    const KNOWN_TYPES = ['gofai','fuzzy-match','neural-net','template-match','keyword-match','embedding','llm','ensemble','transformer'];

    function escHtml(str) {
      return String(str).replace(/[&<>"']/g, c =>
        ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
    }

    function typeChip(type) {
      const slug = type.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const cls = KNOWN_TYPES.includes(slug) ? `type-${slug}` : 'type-default';
      return `<span class="type-chip ${cls}">${escHtml(type)}</span>`;
    }

    function fighterCard(c) {
      const name = c.display_name || c.competitor_id;
      const types = (c.types || []).map(typeChip).join(' ');
      const langs = c.langs || [];
      const config = Object.entries(c.config || {});
      const links = Object.entries(c.links || {});
      const pipeline = c.config?.intents?.pipeline || [];
      const langsLabel = !langs.length ? 'any language'
        : langs.length > 6 ? `${langs.length} languages`
        : langs.join(', ');
      return `
        <article class="card fighter" data-modality="${escHtml(c.modality)}"
                 data-types="${escHtml((c.types || []).join('|').toLowerCase())}"
                 data-langs="${escHtml(langs.join('|').toLowerCase())}"
                 data-search="${escHtml(`${name} ${c.competitor_id}`.toLowerCase())}">
          <div class="fighter-hero">
            ${spriteSvg(c.competitor_id, (c.types || [])[0] || '', 84)}
            <h2><a href="${BASE}fighter/${encodeURIComponent(c.competitor_id)}/" style="color:inherit">${escHtml(name)}</a></h2>
            <span class="badge ${BADGE_CLASS[c.modality] || ''}">${escHtml(MODALITY_LABELS[c.modality] || c.modality)}</span>
            <div class="fighter-types">${types}</div>
          </div>
          ${c.description ? `<p class="fighter-desc">${escHtml(c.description)}</p>` : ''}
          <dl class="fighter-stats">
            ${c.species ? `<dt>Species</dt><dd>${escHtml(c.species)}</dd>` : ''}
            ${c.plugin ? `<dt>Plugin</dt><dd>${escHtml(c.plugin)}</dd>` : ''}
            ${pipeline.length > 1 ? `<dt>Pipeline</dt><dd style="font-size:0.76rem">${pipeline.map(escHtml).join('<br>')}</dd>` : ''}
            ${c.model ? `<dt>Model</dt><dd>${escHtml(c.model)}</dd>` : ''}
            ${c.size ? `<dt>Size</dt><dd style="font-family:var(--font)">${escHtml(c.size)}</dd>` : ''}
            <dt>Languages</dt><dd style="font-family:var(--font)" title="${escHtml(langs.join(', '))}">${escHtml(langsLabel)}</dd>
          </dl>
          <div class="fighter-foot">
            ${config.length ? `
              <details style="font-size:0.82rem">
                <summary style="cursor:pointer;color:var(--muted)">mycroft.conf</summary>
                <pre style="margin:0.4rem 0 0;font-size:0.76rem;overflow-x:auto;color:var(--muted);text-align:left">${escHtml(JSON.stringify(c.config, null, 2))}</pre>
              </details>` : ''}
            ${links.length ? `
              <p style="font-size:0.85rem;margin:0.5rem 0 0">
                ${links.map(([label, url]) =>
                  `<a href="${escHtml(url)}" target="_blank" rel="noopener noreferrer">${escHtml(label)} ↗</a>`
                ).join(' · ')}
              </p>` : ''}
          </div>
        </article>`;
    }

    // ---- subspecies grouping ----------------------------------------
    // Group key: `family` (registry-derived, see registry/schemas.py) is
    // always set by the backend now — for intent leagues it folds
    // config-variant wrapper species (domain-scoped, hierarchical-scoped,
    // …) of the same underlying engine onto one card via FAMILY_ALIASES;
    // for every other league (tts/stt/wake_word/vad) it always equals the
    // fighter's own competitor_id, so each model is a singleton family and
    // gets its own card — that's the intended per-model bestiary for those
    // leagues, not a fallback. `family` can still be unset for a valid
    // intent record with no `species` (schemas.py only derives it from
    // species there), so the `species`/`plugin`/`competitor_id` reads below
    // are a real fallback for those records (and hand-built fixtures), not
    // just defensive.
    const groupKeyOf = c => c.family || c.species || c.plugin || c.competitor_id;

    // "JurebesPipeline" -> "Jurebes Pipeline"; "OnnxASR" -> "Onnx ASR";
    // trailing "Pipeline"/"Plugin" tokens are dropped when there's more
    // than one token, since they describe the OVOS wiring, not the
    // fighter family a human is scanning for.
    function humanizeSpecies(species) {
      const words = species
        .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
        .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
        .split(/\s+/)
        .filter(Boolean);
      if (words.length > 1 && ['Plugin', 'Pipeline'].includes(words[words.length - 1])) {
        words.pop();
      }
      return words.join(' ');
    }

    // "ovos-fasterwhisper-plugin" -> "Fasterwhisper"
    function humanizePlugin(plugin) {
      const words = plugin
        .replace(/^ovos-/, '')
        .replace(/-plugin$/, '')
        .split('-')
        .filter(Boolean)
        .map(w => w.charAt(0).toUpperCase() + w.slice(1));
      return words.join(' ') || plugin;
    }

    function groupDisplayName(key, members) {
      const sample = members[0];
      if (sample.family === key || sample.species === key) return humanizeSpecies(key);
      if (sample.plugin === key) return humanizePlugin(key);
      return sample.display_name || key;
    }

    function groupCard(key, members) {
      const name = escHtml(groupDisplayName(key, members));
      const modalities = [...new Set(members.map(m => m.modality))];
      const langs = [...new Set(members.flatMap(m => m.langs || []))].sort();
      const langsLabel = members.some(m => !(m.langs || []).length) ? 'any language'
        : langs.length > 6 ? `${langs.length} languages` : langs.join(', ');
      const modalityBadges = modalities.map(m =>
        `<span class="badge ${BADGE_CLASS[m] || ''}">${escHtml(MODALITY_LABELS[m] || m)}</span>`).join(' ');
      const groupTypes = [...new Set(members.flatMap(m => m.types || []))];
      const membersHtml = members.map(fighterCard).join('');
      // data-* mirrors the individual .fighter attributes so a group is
      // findable/expandable under the same filters as ungrouped fighters —
      // "matches" is decided per-member below, this is just for the
      // group-level scan in applyFilters().
      return `
        <div class="fighter-group" data-group-key="${escHtml(key)}">
          <details class="group-details card group-card">
            <summary class="group-summary">
              <div class="group-head">
                ${spriteSvg(key, groupTypes[0] || '', 56)}
              </div>
              <div class="group-head">
                <h2>${name}</h2>
                <span class="group-count">${members.length} variants</span>
              </div>
              <div class="group-head">${modalityBadges}</div>
              <div class="group-meta">${escHtml(langsLabel)}</div>
              <span class="group-toggle-hint"></span>
            </summary>
            <div class="group-members">${membersHtml}</div>
          </details>
        </div>`;
    }

    function renderFighters(fighters, groupVariants = true) {
      if (!groupVariants) return fighters.map(fighterCard).join('');
      const groups = new Map();
      for (const c of fighters) {
        const key = groupKeyOf(c);
        (groups.get(key) ?? groups.set(key, []).get(key)).push(c);
      }
      const html = [];
      for (const [key, members] of groups) {
        html.push(members.length > 1 ? groupCard(key, members) : fighterCard(members[0]));
      }
      return html.join('');
    }

    // simple debounce so typing doesn't re-filter the whole grid on every
    // keystroke — fine at this scale, and matches the ~150ms feel of a live
    // search without adding a dependency.
    function debounce(fn, ms) {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn(...args), ms);
      };
    }

    const primaryLang = tag => tag.split(/[-_]/)[0].toLowerCase();

    function langMatches(fighterLangs, wanted) {
      if (!wanted) return true;
      if (!fighterLangs) return true;  // empty list = any language
      const tags = fighterLangs.split('|').filter(Boolean);
      if (!tags.length) return true;
      return tags.some(t => t === wanted.toLowerCase()
                         || primaryLang(t) === primaryLang(wanted));
    }

    // URL state so a filtered dex view is linkable/shareable — mirrors the
    // leaderboard's ?league=&lang= pattern. No dataset filter here: mapping a
    // fighter to "registered datasets" would mean guessing at an association
    // (modality+lang overlap) the data doesn't actually encode per-fighter,
    // and inventing that link would be a fake one — see task note in the PR.
    function syncUrl() {
      const params = new URLSearchParams(window.location.search);
      const modality = document.getElementById('sel-modality').value;
      const type = document.getElementById('sel-type').value;
      const lang = document.getElementById('sel-flang').value;
      const q = document.getElementById('sel-search').value.trim();
      modality ? params.set('modality', modality) : params.delete('modality');
      type ? params.set('type', type) : params.delete('type');
      lang ? params.set('lang', lang) : params.delete('lang');
      q ? params.set('q', q) : params.delete('q');
      const qs = params.toString();
      window.history.replaceState(null, '', `${window.location.pathname}${qs ? '?' + qs : ''}${window.location.hash}`);
    }

    function applyFilters() {
      const modality = document.getElementById('sel-modality').value;
      const type = document.getElementById('sel-type').value.toLowerCase();
      const wanted = document.getElementById('sel-flang').value;
      const q = document.getElementById('sel-search').value.trim().toLowerCase();
      let total = 0, shown = 0;
      document.querySelectorAll('.fighter').forEach(el => {
        total++;
        const show = (!modality || el.dataset.modality === modality)
                  && (!type || el.dataset.types.split('|').includes(type))
                  && langMatches(el.dataset.langs, wanted)
                  && (!q || el.dataset.search.includes(q));
        el.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      // a group matches (and stays visible) if any of its members do;
      // expanding it still only reveals the members that individually
      // matched, since their own display was already set above.
      document.querySelectorAll('.fighter-group').forEach(group => {
        const anyVisible = [...group.querySelectorAll('.fighter')]
          .some(el => el.style.display !== 'none');
        group.style.display = anyVisible ? '' : 'none';
      });
      const counter = document.getElementById('dex-count');
      if (counter) counter.textContent = `Showing ${shown} of ${total} fighters`;
      const filteredEmpty = document.getElementById('dex-filtered-empty');
      const grid = document.getElementById('dex-grid');
      if (filteredEmpty && grid) {
        const noMatches = total > 0 && shown === 0;
        filteredEmpty.style.display = noMatches ? '' : 'none';
        grid.style.display = noMatches ? 'none' : 'grid';
      }
      syncUrl();
    }

    const applyFiltersDebounced = debounce(applyFilters, 150);

    function resetFilters() {
      document.getElementById('sel-modality').value = '';
      document.getElementById('sel-type').value = '';
      document.getElementById('sel-flang').value = '';
      document.getElementById('sel-search').value = '';
      applyFilters();
    }

    function initFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const modality = params.get('modality');
      const type = params.get('type');
      const lang = params.get('lang');
      const q = params.get('q');
      const selModality = document.getElementById('sel-modality');
      const selType = document.getElementById('sel-type');
      const selLang = document.getElementById('sel-flang');
      const selSearch = document.getElementById('sel-search');
      if (modality && [...selModality.options].some(o => o.value === modality)) selModality.value = modality;
      if (type && [...selType.options].some(o => o.value === type)) selType.value = type;
      if (lang && [...selLang.options].some(o => o.value === lang)) selLang.value = lang;
      if (q) selSearch.value = q;
    }

    async function init() {
      const loading = document.getElementById('dex-loading');
      const empty = document.getElementById('dex-empty');
      const grid = document.getElementById('dex-grid');

      const payload = await fetch(`${BASE}data/competitors.json`)
        .then(r => r.ok ? r.json() : null).catch(() => null);
      loading.style.display = 'none';

      const fighters = payload?.competitors || [];
      if (!fighters.length) {
        empty.style.display = '';
        return;
      }

      const types = [...new Set(fighters.flatMap(c => c.types || []))].sort();
      const selType = document.getElementById('sel-type');
      types.forEach(t => {
        const o = document.createElement('option');
        o.value = t; o.textContent = t;
        selType.appendChild(o);
      });

      const allLangs = [...new Set(fighters.flatMap(c => c.langs || []))].sort();
      const selLang = document.getElementById('sel-flang');
      allLangs.forEach(l => {
        const o = document.createElement('option');
        o.value = l; o.textContent = langDisplayName(l);
        selLang.appendChild(o);
      });

      const chkGroup = document.getElementById('chk-group-variants');
      const rerender = () => {
        grid.innerHTML = renderFighters(fighters, chkGroup.checked);
        applyFilters();
      };
      rerender();
      grid.style.display = 'grid';

      ['sel-modality', 'sel-type', 'sel-flang'].forEach(id =>
        document.getElementById(id).addEventListener('change', applyFilters));
      document.getElementById('sel-search').addEventListener('input', applyFiltersDebounced);
      chkGroup.addEventListener('change', rerender);
      document.getElementById('btn-reset-filters').addEventListener('click', resetFilters);

      initFromUrl();
      applyFilters();
    }

    init();
  </script>
</Base>
