---
import Base from '../../layouts/Base.astro';
---
<Base title="Fighters" description="The fighter bestiary — every competitor in the arena, with species, types and stats.">
  <h1>Fighters</h1>
  <p>
    The arena bestiary. Every fighter is a <strong>shippable configuration</strong> declared as a
    JSON file in the <a href="https://github.com/OpenVoiceOS/ovos-plugin-arena/tree/dev/registry">registry</a> —
    a valid <code>mycroft.conf</code> fragment naming its pipeline stages. Its
    <strong>species</strong> is the plugin class it instantiates; its <strong>types</strong>
    describe the architecture doing the matching. Multi-stage pipelines are
    <strong>ensemble</strong> fighters in their own right.
  </p>

  <div class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin-bottom:1.5rem">
    <label for="sel-modality" style="color:var(--muted);font-size:0.9rem">Modality</label>
    <select id="sel-modality" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem">
      <option value="">All</option>
      <option value="stt">STT</option>
      <option value="tts">TTS</option>
      <option value="wake_word">Wake Word</option>
      <option value="vad">VAD</option>
      <option value="intent">Intent · Open</option>
      <option value="intent_template">Intent · Template</option>
      <option value="intent_keyword">Intent · Keyword</option>
    </select>
    <label for="sel-type" style="color:var(--muted);font-size:0.9rem">Type</label>
    <select id="sel-type" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem">
      <option value="">All</option>
    </select>
    <label for="sel-flang" style="color:var(--muted);font-size:0.9rem">Language</label>
    <select id="sel-flang" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem">
      <option value="">All</option>
    </select>
  </div>

  <style>
    #dex-grid { justify-content: center; }
    .fighter {
      margin-bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      text-align: center;
    }
    .fighter-hero { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; }
    .fighter-hero svg { filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.45)); }
    .fighter-hero h2 { margin: 0.2rem 0 0; font-size: 1.2rem; letter-spacing: -0.01em; }
    .fighter-types { display: flex; gap: 0.3rem; flex-wrap: wrap; justify-content: center; }
    .fighter-desc { font-size: 0.86rem; margin: 0; }
    .fighter-stats {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.3rem 0.8rem;
      font-size: 0.82rem;
      margin: 0;
      text-align: left;
      background: rgba(0, 0, 0, 0.22);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.7rem 0.9rem;
    }
    .fighter-stats dt { color: var(--muted); font-weight: 600; }
    .fighter-stats dd { margin: 0; font-family: var(--mono); word-break: break-word; }
    .fighter-foot { margin-top: auto; }
  </style>

  <div id="dex-loading" class="card" aria-live="polite">Loading fighters…</div>
  <div id="dex-empty" class="card" style="display:none">
    No fighters found. Run the <code>export-bestiary</code> CLI / the <code>assemble.yml</code> Action to generate <code>competitors.json</code>.
  </div>
  <div id="dex-grid" style="display:none;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem"></div>

  <script>
    import { spriteSvg, TYPE_HUE } from '../../lib/sprite.js';

    const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
    const MODALITY_LABELS = { stt: 'STT', tts: 'TTS', wake_word: 'Wake Word', vad: 'VAD', intent: 'Intent · Open', intent_template: 'Intent · Template', intent_keyword: 'Intent · Keyword' };
    const BADGE_CLASS = { stt: 'badge-stt', tts: 'badge-tts', wake_word: 'badge-ww', vad: 'badge-vad', intent: 'badge-intent', intent_template: 'badge-intent', intent_keyword: 'badge-intent' };
    const KNOWN_TYPES = ['gofai','fuzzy-match','neural-net','template-match','keyword-match','embedding','llm','ensemble','transformer'];

    function escHtml(str) {
      return String(str).replace(/[&<>"']/g, c =>
        ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
    }

    function typeChip(type) {
      const slug = type.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const cls = KNOWN_TYPES.includes(slug) ? `type-${slug}` : 'type-default';
      return `<span class="type-chip ${cls}">${escHtml(type)}</span>`;
    }

    function fighterCard(c) {
      const name = c.display_name || c.competitor_id;
      const types = (c.types || []).map(typeChip).join(' ');
      const langs = c.langs || [];
      const config = Object.entries(c.config || {});
      const links = Object.entries(c.links || {});
      const pipeline = c.config?.intents?.pipeline || [];
      const langsLabel = !langs.length ? 'any language'
        : langs.length > 6 ? `${langs.length} languages`
        : langs.join(', ');
      return `
        <article class="card fighter" data-modality="${escHtml(c.modality)}"
                 data-types="${escHtml((c.types || []).join('|').toLowerCase())}"
                 data-langs="${escHtml(langs.join('|').toLowerCase())}">
          <div class="fighter-hero">
            ${spriteSvg(c.competitor_id, (c.types || [])[0] || '', 84)}
            <h2>${escHtml(name)}</h2>
            <span class="badge ${BADGE_CLASS[c.modality] || ''}">${escHtml(MODALITY_LABELS[c.modality] || c.modality)}</span>
            <div class="fighter-types">${types}</div>
          </div>
          ${c.description ? `<p class="fighter-desc">${escHtml(c.description)}</p>` : ''}
          <dl class="fighter-stats">
            ${c.species ? `<dt>Species</dt><dd>${escHtml(c.species)}</dd>` : ''}
            ${c.plugin ? `<dt>Plugin</dt><dd>${escHtml(c.plugin)}</dd>` : ''}
            ${pipeline.length > 1 ? `<dt>Pipeline</dt><dd style="font-size:0.76rem">${pipeline.map(escHtml).join('<br>')}</dd>` : ''}
            ${c.model ? `<dt>Model</dt><dd>${escHtml(c.model)}</dd>` : ''}
            ${c.size ? `<dt>Size</dt><dd style="font-family:var(--font)">${escHtml(c.size)}</dd>` : ''}
            <dt>Languages</dt><dd style="font-family:var(--font)" title="${escHtml(langs.join(', '))}">${escHtml(langsLabel)}</dd>
          </dl>
          <div class="fighter-foot">
            ${config.length ? `
              <details style="font-size:0.82rem">
                <summary style="cursor:pointer;color:var(--muted)">mycroft.conf</summary>
                <pre style="margin:0.4rem 0 0;font-size:0.76rem;overflow-x:auto;color:var(--muted);text-align:left">${escHtml(JSON.stringify(c.config, null, 2))}</pre>
              </details>` : ''}
            ${links.length ? `
              <p style="font-size:0.85rem;margin:0.5rem 0 0">
                ${links.map(([label, url]) =>
                  `<a href="${escHtml(url)}" target="_blank" rel="noopener noreferrer">${escHtml(label)} ↗</a>`
                ).join(' · ')}
              </p>` : ''}
          </div>
        </article>`;
    }

    const primaryLang = tag => tag.split(/[-_]/)[0].toLowerCase();

    function langMatches(fighterLangs, wanted) {
      if (!wanted) return true;
      if (!fighterLangs) return true;  // empty list = any language
      const tags = fighterLangs.split('|').filter(Boolean);
      if (!tags.length) return true;
      return tags.some(t => t === wanted.toLowerCase()
                         || primaryLang(t) === primaryLang(wanted));
    }

    function applyFilters() {
      const modality = document.getElementById('sel-modality').value;
      const type = document.getElementById('sel-type').value.toLowerCase();
      const wanted = document.getElementById('sel-flang').value;
      document.querySelectorAll('.fighter').forEach(el => {
        const show = (!modality || el.dataset.modality === modality)
                  && (!type || el.dataset.types.split('|').includes(type))
                  && langMatches(el.dataset.langs, wanted);
        el.style.display = show ? '' : 'none';
      });
    }

    async function init() {
      const loading = document.getElementById('dex-loading');
      const empty = document.getElementById('dex-empty');
      const grid = document.getElementById('dex-grid');

      const payload = await fetch(`${BASE}data/competitors.json`)
        .then(r => r.ok ? r.json() : null).catch(() => null);
      loading.style.display = 'none';

      const fighters = payload?.competitors || [];
      if (!fighters.length) {
        empty.style.display = '';
        return;
      }

      const types = [...new Set(fighters.flatMap(c => c.types || []))].sort();
      const selType = document.getElementById('sel-type');
      types.forEach(t => {
        const o = document.createElement('option');
        o.value = t; o.textContent = t;
        selType.appendChild(o);
      });

      const allLangs = [...new Set(fighters.flatMap(c => c.langs || []))].sort();
      const selLang = document.getElementById('sel-flang');
      allLangs.forEach(l => {
        const o = document.createElement('option');
        o.value = l; o.textContent = l;
        selLang.appendChild(o);
      });

      grid.innerHTML = fighters.map(fighterCard).join('');
      grid.style.display = 'grid';

      ['sel-modality', 'sel-type', 'sel-flang'].forEach(id =>
        document.getElementById(id).addEventListener('change', applyFilters));
    }

    init();
  </script>
</Base>
