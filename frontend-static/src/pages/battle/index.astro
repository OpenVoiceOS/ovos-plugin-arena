---
import Base from '../../layouts/Base.astro';
---
<Base title="Battle" description="Blind A/B battle — pick the better OVOS plugin output and vote.">
  <div style="text-align:center;margin-bottom:1rem">
    <h1 style="font-size:clamp(1.6rem,4vw,2.3rem);font-weight:800;letter-spacing:-0.02em">
      <span style="background:var(--gradient);-webkit-background-clip:text;background-clip:text;color:transparent">⚔️ Blind Battle</span>
    </h1>
    <p style="max-width:560px;margin:0.25rem auto 0">
      Two masked fighters interpret the same input. Pick the better output —
      your vote opens a GitHub issue, no arena account needed.
    </p>
  </div>

  <div id="battle-loading" class="card" aria-live="polite">Loading battles pool…</div>
  <div id="battle-empty" class="card" style="display:none">
    No battles available. Run the <code>assemble.yml</code> GitHub Action to assemble battles from prediction datasets.
  </div>

  <section id="battle-ui" style="display:none" aria-label="Current battle">
    <div class="card" style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem;padding:0.7rem 1.1rem">
      <span id="battle-badge" class="badge"></span>
      <label for="sel-lang" class="sr-only">Battle language</label>
      <select id="sel-lang" title="Only battles in a language you understand"
              style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.25rem 0.5rem;font-size:0.85rem"></select>
      <span id="battle-count" style="color:var(--muted);font-size:0.8rem"></span>
      <span id="battle-id" style="color:var(--muted);font-size:0.72rem;font-family:var(--mono);margin-left:auto"></span>
      <button id="btn-skip" class="btn" style="padding:0.3rem 0.8rem">Skip ↻</button>
    </div>

    <!-- The stimulus -->
    <div class="card" style="text-align:center;border-color:#57393d">
      <p id="input-kicker" style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.4rem">heard utterance</p>
      <p id="battle-input" style="font-size:clamp(1.1rem,3vw,1.5rem);font-weight:700;color:var(--text);margin:0">
      </p>
      <div id="battle-audio" style="margin:0.7rem auto 0;max-width:420px"></div>
      <p id="intent-hint" style="font-size:0.8rem;margin:0.6rem 0 0">
        Which interpretation should a voice assistant act on? “No match” means it would ask the user to rephrase.
      </p>
      <p id="battle-train" style="font-size:0.78rem;margin:0.55rem 0 0;color:var(--muted)"></p>
    </div>

    <!-- The fighters -->
    <div class="vs-grid">
      <div class="card cand" id="cand-a">
        <div class="cand-head">
          <span id="sprite-a"></span>
          <p class="cand-label" style="color:var(--accent)">Candidate A</p>
          <p id="reveal-a" class="cand-reveal"></p>
        </div>
        <div id="payload-a" class="cand-body"></div>
      </div>

      <div class="vs-burst" aria-hidden="true">VS</div>

      <div class="card cand" id="cand-b">
        <div class="cand-head">
          <span id="sprite-b"></span>
          <p class="cand-label" style="color:var(--accent-3)">Candidate B</p>
          <p id="reveal-b" class="cand-reveal"></p>
        </div>
        <div id="payload-b" class="cand-body"></div>
      </div>
    </div>

    <!-- Vote bar -->
    <div id="vote-panel" class="card" style="margin-top:1.25rem;text-align:center">
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;justify-content:center" role="group" aria-label="Vote options">
        <button class="btn btn-primary vote-btn" id="vote-a">🅰 A is better</button>
        <button class="btn btn-primary vote-btn" id="vote-b">🅱 B is better</button>
        <button class="btn vote-btn" id="vote-tie">🤝 Tie</button>
        <button class="btn vote-btn" id="vote-both-wrong">💀 Both wrong</button>
      </div>
      <p id="vote-hint" style="margin:0.9rem 0 0;font-size:0.85rem">
        Voting reveals the fighters and opens a prefilled GitHub issue — submit it to record your vote.
      </p>
    </div>
  </section>

  <style>
    .vs-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1rem;
      align-items: stretch;
      margin-top: 1rem;
    }
    @media (max-width: 760px) {
      .vs-grid { grid-template-columns: 1fr; }
      .vs-burst { margin: -0.4rem auto; }
    }
    .cand {
      margin: 0;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
    }
    .cand:hover { border-color: var(--accent); transform: translateY(-2px); }
    .cand.winner { border-color: var(--win); box-shadow: 0 0 0 1px var(--win); }
    .cand-head {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      margin-bottom: 0.8rem;
    }
    .cand-head svg { filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.45)); }
    .cand-label { font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin: 0.35rem 0 0; }
    .cand-reveal { margin: 0; font-size: 0.88rem; color: var(--muted); min-height: 1.1em; font-weight: 600; }
    .cand-body {
      font-size: 0.95rem;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
    }
    .cand-body .slot-table { margin-left: auto; margin-right: auto; }
    .vs-burst {
      align-self: center;
      font-weight: 900;
      font-size: 1.3rem;
      padding: 0.7rem 0.85rem;
      border-radius: 50%;
      background: var(--gradient);
      color: #fff;
      text-shadow: 0 1px 3px rgba(0,0,0,0.45);
      box-shadow: 0 0 24px rgba(239, 45, 60, 0.45);
      transform: rotate(-6deg);
    }
    .vote-btn { font-size: 1rem; padding: 0.65rem 1.3rem; }
    .slot-table td { padding: 0.2rem 0.6rem 0.2rem 0; border: none; background: none !important; }
  </style>

  <script>
    import { spriteSvg } from '../../lib/sprite.js';

    const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
    const GITHUB_REPO = import.meta.env.VITE_GITHUB_REPO || 'OpenVoiceOS/ovos-plugin-arena';

    const BADGE_CLASS = { stt: 'badge-stt', tts: 'badge-tts', wake_word: 'badge-ww', intent: 'badge-intent', intent_template: 'badge-intent', intent_keyword: 'badge-intent' };
    const MODALITY_LABELS = { stt: 'STT', tts: 'TTS', wake_word: 'Wake Word', intent: 'Intent · Fusions', intent_template: 'Intent · Template', intent_keyword: 'Intent · Keyword' };
    const MODALITY_KICKER = { stt: 'spoken audio — what was said?', tts: 'text to read aloud', wake_word: 'audio clip — did the wake word fire?', intent: 'heard utterance', intent_template: 'heard utterance', intent_keyword: 'heard utterance' };
    const MODALITY_PROMPT = {
      stt: 'Which transcript is closer to what you hear?',
      tts: 'Listen to both voices reading the same line — which sounds better?',
      wake_word: 'Which detector made the right call on this clip?',
    };

    let allBattles = [];
    let battles = [];
    let fightersById = {};
    let currentIdx = 0;
    let currentBattle = null;

    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function pickDefaultLang(langs) {
      const saved = localStorage.getItem('arena-battle-lang');
      if (saved && langs.includes(saved)) return saved;
      // match the browser's languages, full tag first, then primary subtag
      for (const tag of navigator.languages || [navigator.language]) {
        const exact = langs.find(l => l.toLowerCase() === tag.toLowerCase());
        if (exact) return exact;
        const primary = tag.split('-')[0].toLowerCase();
        const close = langs.find(l => l.split('-')[0].toLowerCase() === primary);
        if (close) return close;
      }
      return langs.includes('en-US') ? 'en-US' : langs[0];
    }

    function setLang(lang) {
      localStorage.setItem('arena-battle-lang', lang);
      battles = shuffle(allBattles.filter(b => b.lang === lang));
      currentIdx = 0;
      if (battles.length) loadBattle(battles[0]);
    }

    const esc = s => String(s).replace(/[&<>"']/g, c =>
      ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);

    function buildIssueUrl(battleId, choice) {
      // The `vote` label is applied by the issue form template — labels in
      // the URL would be ignored for non-collaborators.
      const params = new URLSearchParams({
        template: 'vote.yml',
        title: `vote|${battleId}|${choice}`,
      });
      return `https://github.com/${GITHUB_REPO}/issues/new?${params}`;
    }

    function intentCardHtml(payload) {
      if (!payload || payload.intent == null) {
        return `<p style="color:var(--muted);font-style:italic;margin:0">🚫 No match —
                would ask the user to rephrase</p>`;
      }
      const slots = payload.slots || {};
      const slotRows = Object.entries(slots).map(([k, v]) =>
        `<tr><td style="color:var(--muted)">${esc(k)}</td><td>${esc(v)}</td></tr>`).join('');
      return `
        <p style="font-family:var(--mono);font-size:1.02rem;margin:0;color:var(--text)">🎯 ${esc(payload.intent)}</p>
        ${slotRows
          ? `<table class="slot-table" style="margin-top:0.5rem;font-size:0.85rem;width:auto"><tbody>${slotRows}</tbody></table>`
          : '<p style="color:var(--muted);font-size:0.82rem;margin:0.45rem 0 0">no slots extracted</p>'}`;
    }

    function provenanceHtml(b) {
      const info = b.dataset_info || {};
      const link = (label, url) => url
        ? `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer"><code>${esc(label)}</code></a>`
        : `<code>${esc(label)}</code>`;
      const parts = [`eval: ${link(b.dataset_id, info.url)}`];
      const trains = Object.entries(info.train_datasets || {});
      if (trains.length) {
        parts.push('fighters trained on: ' + trains.map(([paradigm, t]) =>
          `${esc(paradigm)} → ${link(t.dataset_id, t.url)}`).join(' · '));
      }
      return parts.join(' &nbsp;·&nbsp; ');
    }

    const isAudioUrl = v => typeof v === 'string' && /^https?:\/\//.test(v) &&
      /\.(wav|mp3|ogg|flac|opus|webm|m4a)(\?|#|$)/i.test(v);

    function audioHtml(src) {
      return `<audio controls preload="none" style="width:100%" src="${esc(src)}">
        <a href="${esc(src)}" target="_blank" rel="noopener noreferrer">audio clip ↗</a></audio>`;
    }

    function payloadHtml(battle, payload) {
      if (battle.modality.startsWith('intent')) return intentCardHtml(payload);
      // TTS candidates are synthesised audio clips; STT/WW are short text
      if (isAudioUrl(payload)) return audioHtml(payload);
      const text = battle.modality === 'wake_word'
        ? (payload === 'detected' ? '🔔 fired — wake word detected'
           : payload === 'not_detected' ? '🔇 silent — no detection' : payload)
        : payload;
      return `<p style="font-family:var(--mono);white-space:pre-wrap;word-break:break-word;margin:0">${esc(text ?? '(no output)')}</p>`;
    }

    function loadBattle(b) {
      currentBattle = b;
      const badge = document.getElementById('battle-badge');
      badge.textContent = MODALITY_LABELS[b.modality] || b.modality;
      badge.className = `badge ${BADGE_CLASS[b.modality] || ''}`;
      document.getElementById('battle-count').textContent =
        `battle ${currentIdx + 1} / ${battles.length}`;
      document.getElementById('battle-id').textContent = `#${b.battle_id}`;
      document.getElementById('battle-input').textContent = b.input_text || '';
      document.getElementById('input-kicker').textContent =
        MODALITY_KICKER[b.modality] || 'input';
      // source-audio stimulus (STT / wake word): the voter listens to the clip
      const audioBox = document.getElementById('battle-audio');
      audioBox.innerHTML = b.audio_url ? audioHtml(b.audio_url) : '';
      // intent gets its "no match" hint; other modalities get their own prompt
      const hint = document.getElementById('intent-hint');
      hint.textContent = b.modality.startsWith('intent')
        ? 'Which interpretation should a voice assistant act on? “No match” means it would ask the user to rephrase.'
        : (MODALITY_PROMPT[b.modality] || '');
      document.getElementById('battle-train').innerHTML = provenanceHtml(b);

      // masked sprites — seeded from battle id + side, so they never leak identity
      document.getElementById('sprite-a').innerHTML = spriteSvg(b.battle_id + '|a', '', 64, true);
      document.getElementById('sprite-b').innerHTML = spriteSvg(b.battle_id + '|b', '', 64, true);
      document.getElementById('reveal-a').textContent = '??? — masked';
      document.getElementById('reveal-b').textContent = '??? — masked';
      document.getElementById('payload-a').innerHTML = payloadHtml(b, b.prediction_a);
      document.getElementById('payload-b').innerHTML = payloadHtml(b, b.prediction_b);
      document.getElementById('cand-a').classList.remove('winner');
      document.getElementById('cand-b').classList.remove('winner');

      ['vote-a','vote-b','vote-tie','vote-both-wrong'].forEach(id => {
        document.getElementById(id).disabled = false;
      });
      document.getElementById('vote-hint').textContent =
        'Voting reveals the fighters and opens a prefilled GitHub issue — submit it to record your vote.';

      document.getElementById('battle-ui').style.display = '';
    }

    function reveal(side, competitorId) {
      const fighter = fightersById[competitorId];
      const type = fighter?.types?.[0] || '';
      const name = fighter?.display_name || competitorId;
      document.getElementById(`sprite-${side}`).innerHTML = spriteSvg(competitorId, type, 64, false);
      document.getElementById(`reveal-${side}`).textContent = name;
    }

    function castVote(choice) {
      if (!currentBattle) return;

      reveal('a', currentBattle.competitor_a);
      reveal('b', currentBattle.competitor_b);
      if (choice === 'a') document.getElementById('cand-a').classList.add('winner');
      if (choice === 'b') document.getElementById('cand-b').classList.add('winner');

      ['vote-a','vote-b','vote-tie','vote-both-wrong'].forEach(id => {
        document.getElementById(id).disabled = true;
      });
      document.getElementById('vote-hint').textContent =
        'Opening the GitHub issue… submit it there to confirm. Next battle in a few seconds.';

      window.open(buildIssueUrl(currentBattle.battle_id, choice), '_blank', 'noopener,noreferrer');
      setTimeout(() => nextBattle(), 4500);
    }

    function nextBattle() {
      if (!battles.length) return;
      currentIdx = (currentIdx + 1) % battles.length;
      loadBattle(battles[currentIdx]);
    }

    async function init() {
      const fetchJson = p => fetch(p).then(r => r.ok ? r.json() : null).catch(() => null);

      const index = await fetchJson(`${BASE}data/index.json`);
      for (const ref of index?.battles_pools || []) {
        const data = await fetchJson(`${BASE}data/${ref.file}`);
        for (const b of data?.battles || []) {
          b.dataset_info = data.dataset_info || null;
          allBattles.push(b);
        }
      }
      const bestiary = await fetchJson(`${BASE}data/competitors.json`);
      for (const f of bestiary?.competitors || []) fightersById[f.competitor_id] = f;

      document.getElementById('battle-loading').style.display = 'none';
      if (!allBattles.length) {
        document.getElementById('battle-empty').style.display = '';
        return;
      }

      const langs = [...new Set(allBattles.map(b => b.lang))].sort();
      const sel = document.getElementById('sel-lang');
      sel.innerHTML = langs.map(l => `<option value="${esc(l)}">${esc(l)}</option>`).join('');
      const lang = pickDefaultLang(langs);
      sel.value = lang;
      sel.addEventListener('change', () => setLang(sel.value));
      setLang(lang);

      document.getElementById('vote-a').addEventListener('click', () => castVote('a'));
      document.getElementById('vote-b').addEventListener('click', () => castVote('b'));
      document.getElementById('vote-tie').addEventListener('click', () => castVote('tie'));
      document.getElementById('vote-both-wrong').addEventListener('click', () => castVote('both_wrong'));
      document.getElementById('btn-skip').addEventListener('click', () => nextBattle());
    }

    init();
  </script>
</Base>
