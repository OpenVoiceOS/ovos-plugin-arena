---
import Base from '../../layouts/Base.astro';
---
<Base title="Leaderboards" description="Benchmark and ELO leaderboards for OVOS plugins — per league and language.">
  <h1>Leaderboards</h1>
  <p>
    One tab per league. <strong>Benchmark boards</strong> are computed directly from
    prediction runs against labelled datasets; <strong>ELO boards</strong> are seeded
    from those benchmarks and refined by human votes in <a href="../battle/">blind battles</a>.
  </p>

  <div id="lb-loading" class="card" aria-live="polite">Loading leaderboard data…</div>
  <div id="lb-empty" class="card" style="display:none">
    No leaderboard data found. Run the <code>assemble.yml</code> GitHub Action to generate data.
  </div>

  <div id="lb-app" style="display:none">
    <div id="league-tabs" role="tablist" aria-label="Leagues"
         style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem"></div>

    <div class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center">
      <label for="sel-lang" style="color:var(--muted);font-size:0.9rem">Language</label>
      <select id="sel-lang" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:0.35rem 0.6rem"></select>
      <div id="dataset-info" style="font-size:0.85rem;color:var(--muted);flex:1;min-width:260px"></div>
    </div>

    <div id="lb-panels"></div>
  </div>

  <style>
    .league-tab {
      padding: 0.45rem 1rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .league-tab:hover { color: var(--text); border-color: var(--muted); }
    .league-tab[aria-selected="true"] {
      background: var(--gradient);
      color: #fff;
      border-color: transparent;
      text-shadow: 0 1px 2px rgba(0,0,0,0.35);
    }
    .board-grid { display: grid; gap: 1.25rem; }
    .board-grid table { font-size: 0.95rem; min-width: 640px; }
    .board-grid th {
      white-space: nowrap;
      font-size: 0.78rem;
      padding: 0.7rem 0.9rem;
    }
    .board-grid td { padding: 0.7rem 0.9rem; white-space: nowrap; }
    .board-grid td:nth-child(2) { white-space: normal; min-width: 200px; }
  </style>

  <script>
    const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

    const LEAGUE_LABELS = {
      intent_template: 'Intent · Template',
      intent_keyword: 'Intent · Keyword',
      intent: 'Intent · Fusions',
      stt: 'STT', tts: 'TTS', wake_word: 'Wake Word',
    };
    const LEAGUE_ORDER = ['intent_template', 'intent_keyword', 'intent', 'stt', 'tts', 'wake_word'];
    // battles + ELO pool by group (intent paradigm leagues share one ELO board);
    // benchmark boards stay per-league.
    const BATTLE_GROUP = { intent_template: 'intent', intent_keyword: 'intent', intent: 'intent', stt: 'stt', tts: 'tts', wake_word: 'wake_word' };
    const METRIC_COLUMNS = [
      ['accuracy', 'Accuracy', true],
      ['macro_f1', 'Macro F1', true],
      ['ood_fpr', 'OOD FPR', true],
      ['slot_exact_match', 'Slot EM', true],
      ['wer_mean', 'WER (mean)', true],
      ['wer_median', 'WER (median)', true],
      ['error_rate', 'Error rate', true],
      ['false_accept_rate', 'False accept', true],
      ['false_reject_rate', 'False reject', true],
      ['latency_ms_median', 'Latency (ms)', false],
    ];

    let benchmarks = [], elos = [];
    let league = '', lang = '';

    const esc = s => String(s).replace(/[&<>"']/g, c =>
      ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
    const pct = v => v == null ? '—' : (v * 100).toFixed(1) + '%';
    const fetchJson = p => fetch(p).then(r => r.ok ? r.json() : null).catch(() => null);

    function fighterCell(e) {
      return `<td><strong>${esc(e.competitor_id)}</strong><br>
        <small style="color:var(--muted)">${esc(e.plugin_id || '')}</small></td>`;
    }

    function benchmarkTable(board, league) {
      if (!board?.entries?.length) {
        const msg = league === 'tts'
          ? 'TTS has no automatic benchmark — voices are judged by human listening votes only. Cast a vote on the <a href="../battle/">Battle</a> page.'
          : 'No benchmark data for this league/language yet.';
        return `<div class="card" style="margin:0"><p style="margin:0">${msg}</p></div>`;
      }
      const present = METRIC_COLUMNS.filter(([k]) => board.entries.some(e => e.metrics?.[k] != null));
      const buckets = [...new Set(board.entries.flatMap(e =>
        Object.keys(e.metrics || {}).filter(k => k.startsWith('acc_'))))].sort();
      const head = ['<th>#</th><th>Fighter</th>',
        ...present.map(([, l]) => `<th>${l}</th>`),
        ...buckets.map(b => `<th class="bucket-col" style="display:none">${esc(b.slice(4))}</th>`),
        '<th>Samples</th>'].join('');
      const rows = board.entries.map(e => `<tr>
        <td style="text-align:right;width:2.4rem;color:var(--muted)">${e.rank}</td>
        ${fighterCell(e)}
        ${present.map(([k,,p]) => `<td>${e.metrics?.[k] == null ? '—' : (p ? pct(e.metrics[k]) : e.metrics[k])}</td>`).join('')}
        ${buckets.map(b => `<td class="bucket-col" style="display:none">${pct(e.metrics?.[b])}</td>`).join('')}
        <td>${e.samples}</td></tr>`).join('');
      return `<section class="card" style="margin:0">
        <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap">
          <h2 style="margin:0;font-size:1.25rem">📊 Benchmark <code style="font-size:0.8rem">${esc(board.dataset_id || '')}</code></h2>
          <span style="color:var(--muted);font-size:0.8rem">primary: ${esc(board.primary_metric)}</span>
          ${buckets.length ? '<button class="btn toggle-buckets" style="padding:0.1rem 0.6rem;font-size:0.75rem;margin-left:auto">show buckets</button>' : ''}
        </div>
        <div style="overflow-x:auto;margin-top:0.9rem">
          <table><thead><tr>${head}</tr></thead><tbody>${rows}</tbody></table>
        </div>
      </section>`;
    }

    function eloTable(board, league) {
      if (!board?.entries?.length) return '<div class="card" style="margin:0"><p style="margin:0">No ELO standings yet — they appear after the first assemble run.</p></div>';
      const note = league === 'tts'
        ? 'Human listening votes only — no benchmark seed; vote in the Battle page.'
        : (league && league.startsWith('intent')
            ? 'Spans all intent engines — template, keyword &amp; fusions compete together.' : '');
      const rows = board.entries.map(e => `<tr>
        <td style="text-align:right;width:2.4rem;color:var(--muted)">${e.rank}</td>
        ${fighterCell(e)}
        <td style="font-weight:700">${Math.round(e.elo)}</td>
        <td style="color:var(--win)">${e.wins}</td>
        <td style="color:var(--loss)">${e.losses}</td>
        <td style="color:var(--tie)">${e.ties}</td>
        <td>${e.human_votes}</td></tr>`).join('');
      return `<section class="card" style="margin:0">
        <div style="display:flex;align-items:baseline;gap:0.6rem;flex-wrap:wrap">
          <h2 style="margin:0;font-size:1.25rem">⚔️ ELO</h2>
          <span style="color:var(--muted);font-size:0.8rem">
            ${board.vote_count - board.human_vote_count} auto-battles + ${board.human_vote_count} human votes
          </span>
        </div>
        ${note ? `<p style="margin:0.35rem 0 0;color:var(--muted);font-size:0.8rem">${note}</p>` : ''}
        <div style="overflow-x:auto;margin-top:0.9rem">
          <table><thead><tr><th>#</th><th>Fighter</th><th>ELO</th>
            <th>Wins</th><th>Losses</th><th>Ties</th><th>Human votes</th></tr></thead>
          <tbody>${rows}</tbody></table>
        </div>
      </section>`;
    }

    function datasetInfoHtml(board) {
      if (!board) return '';
      const info = board.dataset_info || {};
      const parts = [];
      if (board.dataset_id) {
        parts.push(info.url
          ? `Dataset: <a href="${esc(info.url)}" target="_blank" rel="noopener noreferrer"><code>${esc(board.dataset_id)}</code></a>`
          : `Dataset: <code>${esc(board.dataset_id)}</code>`);
      }
      if (info.license) parts.push(`license: ${esc(info.license)}`);
      for (const url of info.predictions || []) {
        parts.push(`<a href="${esc(url)}" target="_blank" rel="noopener noreferrer">predictions ↗</a>`);
      }
      if (board.generated_at) parts.push(`updated ${new Date(board.generated_at).toLocaleString()}`);
      return parts.join(' · ');
    }

    function render() {
      const benches = benchmarks.filter(b => b.modality === league && b.lang === lang)
        .sort((a, b) => (a.dataset_id || '').localeCompare(b.dataset_id || ''));
      // ELO is pooled by battle group — intent sub-leagues share one board
      const elo = elos.find(b => b.modality === BATTLE_GROUP[league] && b.lang === lang);
      document.getElementById('dataset-info').innerHTML = datasetInfoHtml(benches[0]);
      const panels = document.getElementById('lb-panels');
      panels.innerHTML = `<div class="board-grid">${
        benches.length ? benches.map(b => benchmarkTable(b, league)).join('') : benchmarkTable(null, league)
      }${eloTable(elo, league)}</div>`;
      panels.querySelectorAll('.toggle-buckets').forEach(btn => {
        btn.addEventListener('click', () => {
          const cols = btn.closest('section').querySelectorAll('.bucket-col');
          const hidden = cols.length && cols[0].style.display === 'none';
          cols.forEach(c => c.style.display = hidden ? '' : 'none');
          btn.textContent = hidden ? 'hide buckets' : 'show buckets';
        });
      });
    }

    function setLeague(next) {
      league = next;
      document.querySelectorAll('.league-tab').forEach(t =>
        t.setAttribute('aria-selected', t.dataset.league === league ? 'true' : 'false'));
      const langs = [...new Set([...benchmarks, ...elos]
        .filter(b => b.modality === league).map(b => b.lang))].sort();
      const sel = document.getElementById('sel-lang');
      sel.innerHTML = langs.map(l => `<option value="${esc(l)}">${esc(l)}</option>`).join('');
      lang = langs.includes(lang) ? lang : (langs.includes('en-US') ? 'en-US' : langs[0] || '');
      sel.value = lang;
      render();
    }

    async function init() {
      const index = await fetchJson(`${BASE}data/index.json`);
      benchmarks = (await Promise.all((index?.benchmarks || []).map(r => fetchJson(`${BASE}data/${r.file}`)))).filter(Boolean);
      elos = (await Promise.all((index?.leaderboards || []).map(r => fetchJson(`${BASE}data/${r.file}`)))).filter(Boolean);

      document.getElementById('lb-loading').style.display = 'none';
      if (!benchmarks.length && !elos.length) {
        document.getElementById('lb-empty').style.display = '';
        return;
      }

      const leagues = LEAGUE_ORDER.filter(m =>
        benchmarks.some(b => b.modality === m) || elos.some(b => b.modality === m));
      const tabs = document.getElementById('league-tabs');
      tabs.innerHTML = leagues.map(m =>
        `<button class="league-tab" role="tab" data-league="${m}" aria-selected="false">${LEAGUE_LABELS[m] || m}</button>`).join('');
      tabs.querySelectorAll('.league-tab').forEach(t =>
        t.addEventListener('click', () => setLeague(t.dataset.league)));

      document.getElementById('sel-lang').addEventListener('change', e => {
        lang = e.target.value; render();
      });

      document.getElementById('lb-app').style.display = '';
      setLeague(leagues[0]);
    }

    init();
  </script>
</Base>
