---
import Base from '../../layouts/Base.astro';
---
<Base title="Standings" description="The arena standings — ELO ladders and benchmark boards for every OVOS plugin, per league and language.">
  <p class="eyebrow" style="margin-bottom:0.4rem">OVOS Plugin Arena · Rankings</p>
  <h1 style="font-size:clamp(1.8rem,5vw,2.6rem);margin-bottom:0.35rem">The Standings</h1>
  <p style="max-width:62ch">
    Pick a league and a language. The <strong>ladder</strong> is the rating ranking —
    seeded from benchmarks, refined by <a href="../battle/">blind battle</a> votes.
    The <strong>benchmark boards</strong> below it score every fighter straight off
    labelled data. Want to see who beats whom? The <a href="../matchups/">matchup heatmap</a>
    breaks every league down into a head-to-head grid.
  </p>

  <div id="lb-loading" class="card" aria-live="polite">Loading the arena…</div>
  <div id="lb-empty" class="card" style="display:none">
    No standings yet. Run the <code>assemble.yml</code> action to build them from prediction data.
  </div>

  <div id="lb-app" style="display:none">
    <div id="league-tabs" class="lb-tabs" role="tablist" aria-label="Leagues"></div>

    <div class="lb-control">
      <label for="sel-lang" class="lb-lang">
        <span>Language</span>
        <select id="sel-lang"></select>
      </label>
      <label for="sel-dataset" class="lb-lang">
        <span>Dataset</span>
        <select id="sel-dataset"></select>
      </label>
      <label for="chk-group-variants" class="lb-lang" style="cursor:pointer">
        <input type="checkbox" id="chk-group-variants" checked />
        <span>Group variants</span>
      </label>
      <div id="dataset-info" class="lb-meta"></div>
    </div>

    <div id="lb-panels"></div>
  </div>

  <style is:global>
    /* ---- league tabs: character-select chips ---- */
    .lb-tabs { display:flex; gap:0.4rem; flex-wrap:wrap; margin:1.5rem 0 1rem; }
    .lb-tab {
      font-family: var(--display); font-weight:600; font-size:0.82rem;
      letter-spacing:0.02em; padding:0.5rem 0.95rem; cursor:pointer;
      color: var(--muted); background: var(--surface);
      border:1px solid var(--border); border-radius:8px;
      transition: color .15s, border-color .15s, background .15s, transform .1s;
    }
    .lb-tab:hover { color: var(--text); border-color: var(--muted); }
    .lb-tab:active { transform: translateY(1px); }
    .lb-tab[aria-selected="true"] {
      color:#fff; border-color: transparent; background: var(--gradient);
      box-shadow: 0 6px 18px rgba(239,45,60,0.3);
    }

    /* ---- control / meta row ---- */
    .lb-control { display:flex; gap:1rem 1.5rem; flex-wrap:wrap; align-items:center;
      padding:0.7rem 0; border-block:1px solid var(--border); margin-bottom:1.5rem; }
    .lb-lang { display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--muted); }
    .lb-lang select { font-family:var(--mono); background:var(--bg); color:var(--text);
      border:1px solid var(--border); border-radius:7px; padding:0.35rem 0.6rem; }
    .lb-meta { display:flex; gap:0.45rem; flex-wrap:wrap; align-items:center;
      font-size:0.8rem; color:var(--muted); }
    .lb-chip { display:inline-flex; align-items:center; gap:0.3rem; padding:0.15rem 0.55rem;
      border:1px solid var(--border); border-radius:999px; background:var(--surface); }
    .lb-chip code { background:none; border:none; padding:0; font-size:0.82em; color:var(--text); }
    .lb-notes { flex-basis:100%; font-size:0.8rem; color:var(--muted); }
    .lb-notes summary { cursor:pointer; color:var(--text); }
    .lb-notes p { margin:0.35rem 0 0; }

    /* ---- section frame ---- */
    .lb-section { margin-bottom:2.25rem; }
    .lb-section-head { display:flex; align-items:baseline; gap:0.7rem; flex-wrap:wrap; margin-bottom:1rem; }
    .lb-section-head h2 { margin:0; font-size:1.15rem; }
    .lb-section-head .tag { font-size:0.78rem; color:var(--muted); }
    .lb-note { margin:0.1rem 0 1rem; font-size:0.82rem; color:var(--muted);
      border-left:2px solid var(--accent); padding-left:0.6rem; }

    /* ---- per-wake-word phrase grouping ---- */
    .ww-phrase { margin-bottom:1.6rem; }
    .ww-phrase-title { font-family:var(--display); font-weight:600; font-size:1rem;
      margin:0 0 0.7rem; padding-bottom:0.4rem; border-bottom:1px solid var(--border); color:var(--text); }

    /* ---- podium (top 3) ---- */
    .podium { display:grid; grid-template-columns:1fr 1.25fr 1fr; gap:0.8rem; align-items:end; margin-bottom:1rem; }
    .pod {
      position:relative; text-align:center; border:1px solid var(--border);
      border-radius:14px; padding:1.1rem 0.8rem 1rem;
      background:linear-gradient(180deg, var(--surface-2), var(--surface));
    }
    .pod .crown { font-family:var(--pixel); font-size:0.62rem; letter-spacing:0.05em; margin-bottom:0.5rem; }
    .pod .sprite { filter: drop-shadow(0 6px 16px rgba(0,0,0,0.5)); }
    .pod .nm { font-family:var(--display); font-weight:600; font-size:0.95rem; margin:0.5rem 0 0.1rem; }
    .pod .pl { font-family:var(--mono); font-size:0.72rem; color:var(--muted); word-break:break-word; }
    .pod .elo { font-family:var(--display); font-weight:700; font-size:1.6rem; margin-top:0.5rem; line-height:1; }
    .pod .elo small { font-family:var(--pixel); font-size:0.5rem; color:var(--muted); display:block; margin-top:0.35rem; letter-spacing:0.08em; }
    .pod.r1 { border-color:var(--gold); box-shadow:0 0 0 1px var(--gold), 0 10px 30px rgba(255,206,77,0.14); transform:translateY(-10px); }
    .pod.r1 .crown { color:var(--gold); } .pod.r1 .elo { color:var(--gold); }
    .pod.r2 { border-color:var(--silver); } .pod.r2 .crown { color:var(--silver); }
    .pod.r3 { border-color:var(--bronze); } .pod.r3 .crown { color:var(--bronze); }
    .wlt { display:inline-flex; gap:0.3rem; margin-top:0.6rem; font-family:var(--mono); font-size:0.72rem; }
    .wlt b { font-weight:700; }
    .wlt .w { color:var(--win); } .wlt .l { color:var(--loss); } .wlt .t { color:var(--tie); }

    /* ---- ladder rows (rank 4+) ---- */
    .ladder { display:flex; flex-direction:column; gap:0.45rem; }
    .lrow { display:grid; grid-template-columns:2.2rem 40px 1fr auto; align-items:center; gap:0.8rem;
      padding:0.55rem 0.9rem; border:1px solid var(--border); border-radius:10px; background:var(--surface); }
    .lrow:hover { border-color:#57393d; }
    .lrow .rk { font-family:var(--display); font-weight:700; color:var(--muted); text-align:center; }
    .lrow .who { min-width:0; }
    .lrow .who .nm { font-family:var(--display); font-weight:600; font-size:0.92rem; }
    .lrow .who .pl { font-family:var(--mono); font-size:0.72rem; color:var(--muted); }
    .lrow .bar { height:5px; border-radius:3px; background:var(--gradient); margin-top:0.4rem; min-width:6%; }
    .lrow .right { text-align:right; }
    .lrow .right .elo { font-family:var(--display); font-weight:700; font-size:1.15rem; }

    /* ---- grouped-variant ladder rows ---- */
    .lrow.group-row { cursor: pointer; list-style: none; }
    .lrow.group-row::-webkit-details-marker { display: none; }
    .lrow.group-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .lrow.group-row .who .pl { color: var(--accent); }
    .group-badge { font-family: var(--mono); font-size: 0.7rem; color: var(--muted);
      border: 1px solid var(--border); border-radius: 999px; padding: 0.05rem 0.5rem; margin-left: 0.4rem; }
    .lrow-group { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--surface); }
    .lrow-group > .lrow { border: none; border-radius: 0; }
    .lrow-group .group-members { display: none; flex-direction: column; gap: 0.4rem;
      padding: 0.4rem 0.9rem 0.7rem; border-top: 1px solid var(--border); }
    .lrow-group[open] .group-members { display: flex; }
    .lrow-group .group-members .lrow { background: var(--bg); }
    .pod .group-badge { display: block; margin: 0.3rem auto 0; width: fit-content; }

    /* ---- benchmark board ---- */
    .bench { border:1px solid var(--border); border-radius:14px; padding:1.1rem 1.25rem; margin-bottom:1.1rem;
      background:linear-gradient(180deg, var(--surface-2), var(--surface)); }
    .bench-tbl { width:100%; border-collapse:separate; border-spacing:0; }
    .bench-tbl th { font-family:var(--display); font-weight:600; text-transform:none; letter-spacing:0;
      font-size:0.76rem; color:var(--muted); text-align:left; padding:0.4rem 0.6rem; white-space:nowrap; }
    .bench-tbl td { padding:0.55rem 0.6rem; border-top:1px solid var(--border); vertical-align:middle; white-space:nowrap; }
    .bench-tbl tr:first-child td { border-top:none; }
    .bench .nm { font-family:var(--display); font-weight:600; font-size:0.9rem; }
    .bench .pl { font-family:var(--mono); font-size:0.7rem; color:var(--muted); }
    .prim { display:flex; align-items:center; gap:0.6rem; min-width:160px; }
    .prim .v { font-family:var(--display); font-weight:700; font-size:1.05rem; width:4.2rem; }
    .prim .track { flex:1; height:6px; border-radius:3px; background:rgba(255,255,255,0.08); overflow:hidden; min-width:60px; }
    .prim .fill { height:100%; background:var(--gradient); border-radius:3px; }
    .metric-chip { font-family:var(--mono); font-size:0.8rem; color:var(--text); }
    .rank-cell { font-family:var(--display); font-weight:700; color:var(--muted); width:2rem; text-align:center; }
    .rank-cell.m1 { color:var(--gold); } .rank-cell.m2 { color:var(--silver); } .rank-cell.m3 { color:var(--bronze); }
    .sprite-cell svg { display:block; }
    .bucket-col { display:none; }

    @media (max-width:720px) {
      .podium { grid-template-columns:1fr; }
      .pod.r1 { transform:none; order:-1; }
      .lrow { grid-template-columns:1.8rem 32px 1fr auto; gap:0.5rem; }
      .prim { min-width:120px; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .lrow .bar, .prim .fill { animation: grow .5s ease-out; }
      @keyframes grow { from { transform:scaleX(0); transform-origin:left; } }
    }
  </style>

  <script>
    import { spriteSvg } from '../../lib/sprite.js';
    import { groupedLangOptionsHtml } from '../../lib/lang.js';

    const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

    const METRIC_COLUMNS = [
      ['accuracy', 'Accuracy', true], ['macro_f1', 'Macro F1', true],
      ['ood_fpr', 'OOD FPR', true], ['slot_exact_match', 'Slot EM', true],
      ['wer_mean', 'WER mean', true], ['wer_median', 'WER med.', true],
      ['error_rate', 'Error', true], ['false_accept_rate', 'False acc.', true],
      ['false_reject_rate', 'False rej.', true], ['latency_ms_median', 'Latency ms', false],
      ['utmos', 'UTMOS', false], ['intelligibility_wer', 'Intellig. WER', true],
      ['ece', 'ECE', false],
    ];
    // primary_metric values whose raw scale is naturally "higher is
    // better" — accuracy/macro_f1/etc. are already ratios in [0,1] where
    // higher wins; utmos is a 1-5 MOS scale, also higher wins. Anything
    // else here (wer_mean, error_rate, …) is "lower is better" and the
    // score-bar fill inverts it.
    const HIGHER_IS_BETTER = new Set(['accuracy', 'utmos']);
    // metric key -> [key, label, percent] lookup built from METRIC_COLUMNS,
    // used so the primary-metric cell renders per its own percent flag
    // instead of always assuming a 0..1 ratio (e.g. UTMOS is a 1..5 MOS
    // score, not a percentage).
    const METRIC_COLUMN_BY_KEY = Object.fromEntries(
      METRIC_COLUMNS.map(([k, l, p]) => [k, [k, l, p]]));
    const fmtMetric = (key, v) => {
      if (v == null) return '—';
      const percent = METRIC_COLUMN_BY_KEY[key]?.[2] ?? false;
      if (percent) return pct(v);
      // ece is a calibration-error magnitude in [0, 1], not a percentage —
      // keep 3 decimals so small (well-calibrated) values stay distinguishable.
      if (key === 'ece') return v.toFixed(3);
      return (Math.round(v * 100) / 100).toFixed(2);
    };

    // leagues: [{id, label, battle_group, order}] from data/index.json — the
    // frontend has no hardcoded notion of what leagues exist or how they map
    // to battle groups; that's owned by arena/models.py (leagues()).
    //
    // index.json itself is fetched WITHOUT a cache-bust param, so a stale
    // CDN edge can serve a pre-this-PR copy that has no `leagues` array at
    // all. DEFAULT_LEAGUES mirrors arena/models.py::leagues() exactly, so a
    // stale index degrades to the old pre-PR behavior instead of crashing
    // on an empty tab list.
    const DEFAULT_LEAGUES = [
      { id: 'intent_template', label: 'Intent · Template', battle_group: 'intent_template', order: 0 },
      { id: 'intent_keyword', label: 'Intent · Keyword', battle_group: 'intent_keyword', order: 1 },
      { id: 'intent', label: 'Intent · Fusions', battle_group: 'intent', order: 2 },
      { id: 'stt', label: 'STT', battle_group: 'stt', order: 3 },
      { id: 'tts', label: 'TTS', battle_group: 'tts', order: 4 },
      { id: 'wake_word', label: 'Wake Word', battle_group: 'wake_word', order: 5 },
      { id: 'vad', label: 'VAD', battle_group: 'vad', order: 6 },
    ];
    // ---- subspecies grouping (mirrors ../fighters/index.astro) --------
    const GROUP_STORAGE_KEY = 'arena.leaderboard.groupVariants';
    let groupVariants = true;
    try {
      const stored = localStorage.getItem(GROUP_STORAGE_KEY);
      if (stored !== null) groupVariants = stored === '1';
    } catch { /* localStorage unavailable (private mode, SSR) — keep default ON */ }

    const groupKeyOf = id => fighters[id]?.species || fighters[id]?.plugin || id;

    function humanizeSpecies(species) {
      const words = species
        .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
        .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
        .split(/\s+/).filter(Boolean);
      if (words.length > 1 && ['Plugin', 'Pipeline'].includes(words[words.length - 1])) words.pop();
      return words.join(' ');
    }
    function humanizePlugin(plugin) {
      const words = plugin.replace(/^ovos-/, '').replace(/-plugin$/, '')
        .split('-').filter(Boolean).map(w => w.charAt(0).toUpperCase() + w.slice(1));
      return words.join(' ') || plugin;
    }
    function groupDisplayName(key, ids) {
      const f = fighters[ids[0]];
      if (f?.species === key) return humanizeSpecies(key);
      if (f?.plugin === key) return humanizePlugin(key);
      return nameOf(ids[0]);
    }

    // Collapse CONTIGUOUS runs of entries sharing a group key into one
    // node — matches the fighters bestiary's grouping key, but only
    // merges fighters that are actually ranked next to each other, so a
    // family scattered across the ladder (rare, but possible) stays as
    // separate rows rather than being yanked together out of rank order.
    // The group node's rank is its best (first, since entries arrive
    // best-first) member's rank.
    function collapseGroups(entries) {
      if (!groupVariants) return entries.map(e => ({ group: false, entry: e }));
      const nodes = [];
      let i = 0;
      while (i < entries.length) {
        const key = groupKeyOf(entries[i].competitor_id);
        let j = i + 1;
        while (j < entries.length && groupKeyOf(entries[j].competitor_id) === key) j++;
        const run = entries.slice(i, j);
        if (run.length > 1) {
          nodes.push({ group: true, key, members: run });
        } else {
          nodes.push({ group: false, entry: run[0] });
        }
        i = j;
      }
      return nodes;
    }

    let leagues = [], leagueById = {};
    // metadata only — {file, modality, dataset_id, lang, count}, cheap to
    // hold in full since the frontend needs it to know what's fetchable.
    let benchmarksMeta = [], leaderboardsMeta = [];
    let fighters = {};
    let league = '', lang = '', dataset = '', cacheV = '';
    // lazily fetched board bodies, keyed by file name — a selection change
    // only ever fetches the files that match it, never the full corpus.
    const fileCache = new Map();

    const esc = s => String(s).replace(/[&<>"']/g, c =>
      ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
    const pct = v => v == null ? '—' : (v * 100).toFixed(1) + '%';
    const fetchJson = p => fetch(p).then(r => r.ok ? r.json() : null).catch(() => null);
    const typeOf = id => (fighters[id]?.types || [])[0] || '';
    const nameOf = id => fighters[id]?.display_name || id;
    const sprite = (id, size) => spriteSvg(id, typeOf(id), size, false);
    // wake-word phrase a fighter targets (its hotword config key)
    const phraseOf = id => Object.keys(fighters[id]?.config?.hotwords || {})[0] || '';

    function wlt(e) {
      return `<span class="wlt"><span class="w">${e.wins}<b>W</b></span>
        <span class="l">${e.losses}<b>L</b></span><span class="t">${e.ties}<b>T</b></span></span>`;
    }

    // Fighter detail page href, base-path aware — same route the fighters
    // bestiary links to (fighter/[id].astro). Every row that names a real
    // fighter (not a group header, which expands instead of navigating)
    // uses this so the name itself is the link — discernible link text,
    // no click-catching wrapper div.
    const fighterHref = id => `${BASE}fighter/${encodeURIComponent(id)}/`;
    const fighterLink = id => `<a href="${fighterHref(id)}">${esc(nameOf(id))}</a>`;

    // Fighter list with no rank/crown/podium chrome at all — used when a
    // board is provisional with zero votes cast: any ordering the backend
    // ships (a single fighter, or an arbitrary seed order) is not a real
    // ranking and must not be dressed up as one (no "① CHAMPION" for a
    // fighter that has never fought).
    function renderUnranked(entries) {
      return `<div class="ladder unranked">${entries.map(e => `
        <div class="lrow">
          <span class="rk" aria-hidden="true">–</span>
          <span class="sprite-cell">${sprite(e.competitor_id, 40)}</span>
          <span class="who">
            <span class="nm">${fighterLink(e.competitor_id)}</span>
            <span class="pl"> · ${esc(e.plugin_id || '')}</span>
          </span>
          <span class="right"><span class="pl">unrated</span></span>
        </div>`).join('')}</div>`;
    }

    function ratingBounds(nodes) {
      const vals = nodes.map(n => n.group
        ? n.members.map(m => m.bt_rating)
        : [n.entry.bt_rating]).flat();
      return { lo: Math.min(...vals), hi: Math.max(...vals) };
    }

    // Single ranked ladder row — used both for standalone fighters and,
    // reused as-is, for the individual rows revealed inside an expanded
    // group. `r` is the fighter's own display rank.
    function ladderRowHtml(e, r, strength) {
      return `<div class="lrow">
          <span class="rk">${r}</span>
          <span class="sprite-cell">${sprite(e.competitor_id, 40)}</span>
          <span class="who">
            <span class="nm">${fighterLink(e.competitor_id)}</span>
            <span class="pl"> · ${esc(e.plugin_id || '')}</span>
            <div class="bar" style="width:${strength(e.bt_rating)}%"></div>
          </span>
          <span class="right"><span class="elo">${Math.round(e.bt_rating)}</span><br>${e.battles ? wlt(e) : '<span class="pl">unrated</span>'}</span>
        </div>`;
    }

    function groupRowHtml(node, strength) {
      const ratings = node.members.map(m => m.bt_rating);
      const min = Math.min(...ratings), max = Math.max(...ratings);
      const avg = ratings.reduce((a, b) => a + b, 0) / ratings.length;
      const totals = node.members.reduce((acc, m) => ({
        wins: acc.wins + (m.wins || 0), losses: acc.losses + (m.losses || 0), ties: acc.ties + (m.ties || 0),
      }), { wins: 0, losses: 0, ties: 0 });
      const hasBattles = node.members.some(m => m.battles);
      const name = esc(groupDisplayName(node.key, node.members.map(m => m.competitor_id)));
      const members = node.members
        .map(m => ladderRowHtml(m, m.r, strength)).join('');
      return `<details class="lrow-group">
        <summary class="lrow group-row">
          <span class="rk">${node.r}</span>
          <span class="sprite-cell">${sprite(node.key, 40)}</span>
          <span class="who">
            <span class="nm">${name}<span class="group-badge">${node.members.length} variants</span></span>
            <span class="pl">min ${Math.round(min)} · avg ${Math.round(avg)} · max ${Math.round(max)}</span>
            <div class="bar" style="width:${strength(avg)}%"></div>
          </span>
          <span class="right"><span class="elo">${Math.round(avg)}</span><br>${hasBattles ? wlt(totals) : '<span class="pl">unrated</span>'}</span>
        </summary>
        <div class="group-members">${members}</div>
      </details>`;
    }

    function podHtml(node, crowns) {
      if (node.group) {
        const ratings = node.members.map(m => m.bt_rating);
        const min = Math.min(...ratings), max = Math.max(...ratings);
        const avg = ratings.reduce((a, b) => a + b, 0) / ratings.length;
        const name = esc(groupDisplayName(node.key, node.members.map(m => m.competitor_id)));
        return `<div class="pod r${node.r}">
          <div class="crown">${crowns[node.r] || ''}</div>
          <span class="sprite">${sprite(node.key, node.r === 1 ? 76 : 60)}</span>
          <p class="nm">${name}</p>
          <p class="pl">${node.members.length} variants</p>
          <p class="elo">${Math.round(avg)}<small>AVG RATING</small></p>
          <span class="group-badge">min ${Math.round(min)} · max ${Math.round(max)}</span>
        </div>`;
      }
      const e = node.entry;
      return `<div class="pod r${node.r}">
          <div class="crown">${crowns[node.r] || ''}</div>
          <span class="sprite">${sprite(e.competitor_id, node.r === 1 ? 76 : 60)}</span>
          <p class="nm">${fighterLink(e.competitor_id)}</p>
          <p class="pl">${esc(e.plugin_id || '')}</p>
          <p class="elo">${Math.round(e.bt_rating)}<small>RATING</small></p>
          ${e.battles ? wlt(e) : ''}
        </div>`;
    }

    function renderRanking(entries) {
      // entries already ordered best-first; rank by position
      const E = entries.map((e, i) => ({ ...e, r: i + 1 }));
      const nodes = collapseGroups(E).map(n => n.group
        ? { group: true, key: n.key, members: n.members, r: n.members[0].r }
        : { group: false, entry: n.entry, r: n.entry.r });
      const { lo, hi } = ratingBounds(nodes);
      const strength = v => hi === lo ? 60 : Math.round(6 + 94 * (v - lo) / (hi - lo));
      const crowns = { 1: '① CHAMPION', 2: '② RUNNER-UP', 3: '③ THIRD' };
      const top = nodes.slice(0, 3);
      const podOrder = top.length === 3 ? [top[1], top[0], top[2]] : top;
      const podium = top.length >= 2
        ? `<div class="podium">${podOrder.map(n => podHtml(n, crowns)).join('')}</div>` : '';
      const rest = nodes.slice(top.length >= 2 ? 3 : 0);
      const ladder = rest.length ? `<div class="ladder">${rest.map(n =>
        n.group ? groupRowHtml(n, strength) : ladderRowHtml(n.entry, n.r, strength)).join('')}</div>` : '';
      return podium + ladder;
    }

    function eloSection(board, league) {
      // A provisional board with zero votes cast has nothing to rank from —
      // whatever order the backend ships is not a real ranking, so no
      // podium/crown chrome, just the fighter list.
      const unranked = !!(board && board.provisional && board.vote_count === 0);
      const note = league === 'tts'
        ? 'Ranked by human listening votes only — no benchmark seed. Vote in the Battle page.'
        : league === 'wake_word'
          ? 'One ranking per wake word — detectors only compete on the same phrase.'
        : league === 'vad'
          ? 'Voice Activity Detection — fighters are language-agnostic; boards are grouped by the dataset’s language.'
        : (league && league.startsWith('intent')
            ? 'One ladder for every intent engine — template, keyword and fusions compete together.' : '');
      const head = `<div class="lb-section-head">
        <p class="eyebrow" style="color:var(--accent)">The Ladder</p>
        <h2>${unranked ? '🎲 Unranked' : '⚔️ Rating ranking'}</h2>
        ${board ? `<span class="tag">${board.vote_count - board.human_vote_count} auto-battles · ${board.human_vote_count} human votes</span>` : ''}
      </div>${note ? `<p class="lb-note">${note}</p>` : ''}
      ${unranked ? '<p class="lb-note">Unranked — no votes yet, order not meaningful.</p>' : ''}`;
      if (!board?.entries?.length)
        return `<section class="lb-section">${head}<div class="card" style="margin:0">No ladder standings yet.</div></section>`;

      let body;
      if (league === 'wake_word') {
        // a separate ranking per wake-word phrase
        const byPhrase = {};
        for (const e of board.entries)
          (byPhrase[phraseOf(e.competitor_id) || 'other'] ??= []).push(e);
        body = Object.keys(byPhrase).sort().map(ph => `
          <div class="ww-phrase">
            <p class="ww-phrase-title">📣 “${esc(ph.replace(/_/g, ' '))}”</p>
            ${unranked ? renderUnranked(byPhrase[ph]) : renderRanking(byPhrase[ph])}
          </div>`).join('');
      } else {
        body = unranked ? renderUnranked(board.entries) : renderRanking(board.entries);
      }
      return `<section class="lb-section">${head}${body}</section>`;
    }

    function benchBoard(board, league) {
      if (!board?.entries?.length) {
        const msg = league === 'tts'
          ? 'TTS has no automatic benchmark — voices are judged by ear in <a href="../battle/">blind battles</a>.'
          : 'No benchmark board for this league and language yet.';
        return `<div class="bench">${msg}</div>`;
      }
      const primary = board.primary_metric;
      const higher = HIGHER_IS_BETTER.has(primary);
      // Score-bar normalization: most primary metrics are already ratios
      // in [0,1] (accuracy, wer_mean, …) where 1-v inverts a lower-is-
      // better metric into a fill fraction. UTMOS is a MOS scale (1..5,
      // higher is better) — normalize by /5 before clamping instead.
      const scale = primary === 'utmos' ? 5 : 1;
      const score = v => v == null ? 0 : Math.max(0, Math.min(1, higher ? v / scale : 1 - v / scale));
      const secondary = METRIC_COLUMNS.filter(([k]) => k !== primary &&
        board.entries.some(e => e.metrics?.[k] != null));
      const buckets = [...new Set(board.entries.flatMap(e =>
        Object.keys(e.metrics || {}).filter(k => k.startsWith('acc_'))))].sort();
      const medal = r => r <= 3 ? `m${r}` : '';
      const head = `<tr><th></th><th></th><th>Fighter</th><th>${esc(primary)}</th>
        ${secondary.map(([, l]) => `<th>${l}</th>`).join('')}
        ${buckets.map(b => `<th class="bucket-col">${esc(b.slice(4))}</th>`).join('')}
        <th>Samples</th></tr>`;
      const rows = board.entries.map(e => `<tr>
        <td class="rank-cell ${medal(e.rank)}">${e.rank}</td>
        <td class="sprite-cell">${sprite(e.competitor_id, 34)}</td>
        <td><div class="nm">${fighterLink(e.competitor_id)}</div><div class="pl">${esc(e.plugin_id || '')}</div></td>
        <td><div class="prim"><span class="v">${fmtMetric(primary, e.metrics?.[primary])}</span>
          <span class="track"><span class="fill" style="width:${(score(e.metrics?.[primary]) * 100).toFixed(0)}%"></span></span></div></td>
        ${secondary.map(([k]) => `<td class="metric-chip">${fmtMetric(k, e.metrics?.[k])}</td>`).join('')}
        ${buckets.map(b => `<td class="bucket-col metric-chip">${pct(e.metrics?.[b])}</td>`).join('')}
        <td class="metric-chip">${e.samples}</td></tr>`).join('');
      return `<div class="bench">
        <div class="lb-section-head" style="margin-bottom:0.8rem">
          <h2 style="font-size:1rem">📊 ${esc(board.dataset_id || '')}</h2>
          <span class="tag">primary metric · ${esc(primary)}</span>
          ${buckets.length ? '<button class="btn toggle-buckets" style="padding:0.1rem 0.6rem;font-size:0.72rem;margin-left:auto">show buckets</button>' : ''}
        </div>
        <div style="overflow-x:auto"><table class="bench-tbl"><thead>${head}</thead><tbody>${rows}</tbody></table></div>
      </div>`;
    }

    function datasetInfoHtml(board) {
      if (!board) return '';
      const info = board.dataset_info || {};
      const chip = (inner) => `<span class="lb-chip">${inner}</span>`;
      const parts = [];
      if (board.dataset_id) parts.push(chip(info.url
        ? `<a href="${esc(info.url)}" target="_blank" rel="noopener noreferrer"><code>${esc(board.dataset_id)}</code></a>`
        : `<code>${esc(board.dataset_id)}</code>`));
      if (info.license) parts.push(chip(esc(info.license)));
      if ((info.predictions || []).length)
        parts.push(chip(`<a href="${esc(info.predictions[0])}" target="_blank" rel="noopener noreferrer">predictions ↗</a>`));
      if (board.generated_at) parts.push(`<span style="opacity:0.7">updated ${new Date(board.generated_at).toLocaleDateString()}</span>`);
      let html = parts.join('');
      // caveats (e.g. "recall-only benchmark") must reach users, not just
      // maintainers reading the registry JSON — collapsed by default so it
      // doesn't crowd the chip row, but never dropped.
      if (info.notes) html += `<details class="lb-notes">
        <summary>Dataset notes</summary>
        <p>${esc(info.notes)}</p>
      </details>`;
      return html;
    }

    // fetch (with in-memory caching) just the board files a metadata list
    // points at — never the whole 260-file corpus.
    async function fetchBoards(metaList) {
      await Promise.all(metaList.map(async m => {
        if (!fileCache.has(m.file)) {
          const body = await fetchJson(`${BASE}data/${m.file}${cacheV}`);
          // only cache a successful fetch — a transient failure (or a stale
          // CDN edge) must not poison the cache with a permanent null
          if (body != null) fileCache.set(m.file, body);
        }
      }));
      return metaList.map(m => fileCache.get(m.file)).filter(Boolean);
    }

    // monotonic token guarding against out-of-order async renders: a slow
    // fetch for a league the user has since navigated away from must not
    // overwrite the panels with stale content once it resolves.
    let renderSeq = 0;

    async function render() {
      const seq = ++renderSeq;
      const group = leagueById[league]?.battle_group;
      const benchMeta = benchmarksMeta.filter(b => b.modality === league && b.lang === lang &&
        (!dataset || b.dataset_id === dataset));
      const eloMeta = leaderboardsMeta.filter(b => b.modality === group && b.lang === lang);
      const [benches, eloBoards] = await Promise.all([fetchBoards(benchMeta), fetchBoards(eloMeta)]);
      if (seq !== renderSeq) return; // a newer render superseded this one
      benches.sort((a, b) => (a.dataset_id || '').localeCompare(b.dataset_id || ''));
      const elo = eloBoards[0];

      document.getElementById('dataset-info').innerHTML = datasetInfoHtml(benches[0]);
      const panels = document.getElementById('lb-panels');
      panels.innerHTML = eloSection(elo, league) + `<section class="lb-section">
        <div class="lb-section-head"><p class="eyebrow" style="color:var(--accent)">The Data</p>
          <h2>📊 Benchmark boards</h2></div>
        ${benches.length ? benches.map(b => benchBoard(b, league)).join('') : benchBoard(null, league)}
      </section>`;
      panels.querySelectorAll('.toggle-buckets').forEach(btn => {
        btn.addEventListener('click', () => {
          const cols = btn.closest('.bench').querySelectorAll('.bucket-col');
          const hidden = cols.length && getComputedStyle(cols[0]).display === 'none';
          cols.forEach(c => c.style.display = hidden ? 'table-cell' : 'none');
          btn.textContent = hidden ? 'hide buckets' : 'show buckets';
        });
      });
    }

    // reflect league/lang/dataset in the URL so a view is linkable/shareable —
    // replaceState (not push) so tab/select changes don't spam browser history
    function syncUrl() {
      const params = new URLSearchParams(window.location.search);
      league ? params.set('league', league) : params.delete('league');
      lang ? params.set('lang', lang) : params.delete('lang');
      dataset ? params.set('dataset', dataset) : params.delete('dataset');
      const qs = params.toString();
      const url = `${window.location.pathname}${qs ? '?' + qs : ''}${window.location.hash}`;
      window.history.replaceState(null, '', url);
    }

    function populateDatasets() {
      const datasets = [...new Set(benchmarksMeta
        .filter(b => b.modality === league && b.lang === lang)
        .map(b => b.dataset_id))].sort();
      const sel = document.getElementById('sel-dataset');
      sel.innerHTML = `<option value="">All datasets</option>` +
        datasets.map(d => `<option value="${esc(d)}">${esc(d)}</option>`).join('');
      dataset = datasets.includes(dataset) ? dataset : '';
      sel.value = dataset;
      // no per-dataset ladder distinction yet — hide the control when it can't narrow anything
      sel.closest('label').style.display = datasets.length > 1 ? '' : 'none';
    }

    function setLeague(next) {
      league = next;
      const group = leagueById[league]?.battle_group;
      document.querySelectorAll('.lb-tab').forEach(t =>
        t.setAttribute('aria-selected', t.dataset.league === league ? 'true' : 'false'));
      const langs = [...new Set([
        ...benchmarksMeta.filter(b => b.modality === league),
        ...leaderboardsMeta.filter(b => b.modality === group),
      ].map(b => b.lang))].sort();
      const sel = document.getElementById('sel-lang');
      sel.innerHTML = groupedLangOptionsHtml(langs);
      lang = langs.includes(lang) ? lang : (langs.includes('en-US') ? 'en-US' : langs[0] || '');
      sel.value = lang;
      populateDatasets();
      syncUrl();
      render();
    }

    async function init() {
      const index = await fetchJson(`${BASE}data/index.json`);
      // cache-bust per-board fetches with the index build stamp so CDN staleness can't mask fresh boards
      cacheV = index?.generated_at ? `?v=${encodeURIComponent(index.generated_at)}` : '';
      benchmarksMeta = index?.benchmarks || [];
      leaderboardsMeta = index?.leaderboards || [];
      leagues = (index?.leagues && index.leagues.length) ? index.leagues : DEFAULT_LEAGUES;
      leagueById = Object.fromEntries(leagues.map(l => [l.id, l]));
      const bestiary = await fetchJson(`${BASE}data/competitors.json${cacheV}`);
      for (const f of bestiary?.competitors || []) fighters[f.competitor_id] = f;

      document.getElementById('lb-loading').style.display = 'none';
      if (!benchmarksMeta.length && !leaderboardsMeta.length) {
        document.getElementById('lb-empty').style.display = '';
        return;
      }

      const activeLeagues = leagues
        .filter(l => benchmarksMeta.some(b => b.modality === l.id) ||
          leaderboardsMeta.some(b => b.modality === l.battle_group))
        .sort((a, b) => a.order - b.order);
      const tabs = document.getElementById('league-tabs');
      tabs.innerHTML = activeLeagues.map(l =>
        `<button class="lb-tab" role="tab" data-league="${l.id}" aria-selected="false">${esc(l.label)}</button>`).join('');
      tabs.querySelectorAll('.lb-tab').forEach(t =>
        t.addEventListener('click', () => setLeague(t.dataset.league)));
      document.getElementById('sel-lang').addEventListener('change', e => {
        lang = e.target.value; dataset = ''; populateDatasets(); syncUrl(); render();
      });
      document.getElementById('sel-dataset').addEventListener('change', e => {
        dataset = e.target.value; syncUrl(); render();
      });
      const chkGroup = document.getElementById('chk-group-variants');
      chkGroup.checked = groupVariants;
      chkGroup.addEventListener('change', e => {
        groupVariants = e.target.checked;
        try { localStorage.setItem(GROUP_STORAGE_KEY, groupVariants ? '1' : '0'); } catch { /* ignore */ }
        render();
      });

      document.getElementById('lb-app').style.display = '';

      // initialize selection from URL params, falling back to the first
      // active league (and its default lang/dataset) as before
      const urlParams = new URLSearchParams(window.location.search);
      const wantLeague = urlParams.get('league');
      const wantLang = urlParams.get('lang');
      const wantDataset = urlParams.get('dataset');
      const startLeague = activeLeagues.some(l => l.id === wantLeague) ? wantLeague : activeLeagues[0].id;
      if (wantLang) lang = wantLang;
      if (wantDataset) dataset = wantDataset;
      setLeague(startLeague);
    }

    init();
  </script>
</Base>
