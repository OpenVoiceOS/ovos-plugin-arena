---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'OVOS Plugin Arena — blind A/B plugin evaluation with ELO leaderboards' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — OVOS Plugin Arena</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0c0a0a;
        --surface: #171213;
        --surface-2: #1f1719;
        --border: #392b2d;
        --text: #f2e9e9;
        --muted: #ab9a9c;
        --accent: #ff4d4f;
        --accent-hover: #ff7875;
        --accent-2: #e5333c;
        --accent-3: #ff8a65;
        --win: #3fb950;
        --loss: #f85149;
        --tie: #d29922;
        --radius: 10px;
        --gradient: linear-gradient(100deg, #ff6b6b 0%, #ef2d3c 55%, #ff8a65 100%);
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        --mono: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
      }

      body {
        background:
          radial-gradient(1100px 480px at 18% -8%, rgba(239, 45, 60, 0.13), transparent 60%),
          radial-gradient(900px 420px at 85% -12%, rgba(255, 107, 107, 0.08), transparent 55%),
          var(--bg);
        background-attachment: fixed;
        color: var(--text);
        font-family: var(--font);
        font-size: 16px;
        line-height: 1.55;
        min-height: 100vh;
      }

      ::selection { background: rgba(239, 45, 60, 0.4); }
      code, pre { font-family: var(--mono); }
      code {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 0.08rem 0.35rem;
        font-size: 0.86em;
      }
      pre code { background: none; border: none; padding: 0; }

      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--accent-hover); text-decoration: underline; }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      header {
        background: rgba(14, 10, 11, 0.85);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        padding: 0 1.5rem;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header nav {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 2rem;
        height: 56px;
      }
      header .logo {
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
        background: var(--gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-decoration: none;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }
      header .logo .mark { font-size: 1.15rem; -webkit-text-fill-color: initial; }
      header .logo:hover { text-decoration: none; filter: brightness(1.2); }
      header nav ul {
        display: flex;
        gap: 1.5rem;
        list-style: none;
      }
      header nav ul a { font-size: 0.9rem; color: var(--muted); }
      header nav ul a:hover, header nav ul a.active { color: var(--text); }

      main {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }

      h1 { font-size: 1.75rem; margin-bottom: 0.5rem; }
      h2 { font-size: 1.3rem; margin-bottom: 0.75rem; margin-top: 1.5rem; }
      p { margin-bottom: 1rem; color: var(--muted); }

      .card {
        background: linear-gradient(180deg, var(--surface-2) 0%, var(--surface) 100%);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
        transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
      }
      .card:hover {
        border-color: #57393d;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
      }
      article.card.fighter:hover { transform: translateY(-3px); }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      th {
        text-align: left;
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid var(--border);
        color: var(--muted);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      td {
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid var(--border);
      }
      tr:last-child td { border-bottom: none; }
      tbody tr:nth-child(odd) td { background: rgba(255, 255, 255, 0.015); }
      tr:hover td { background: rgba(255, 77, 79, 0.06); }
      tbody tr:first-child td:first-child { color: var(--tie) !important; font-weight: 700; }

      .badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .badge-stt { background: #1f3a5f; color: #58a6ff; }
      .badge-tts { background: #1f3d2f; color: #3fb950; }
      .badge-ww  { background: #3d2a1f; color: #d29922; }
      .badge-intent { background: #2d1f3d; color: #bc8cff; }

      /* fighter type chips (bestiary) */
      .type-chip {
        display: inline-block;
        padding: 0.1rem 0.55rem;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        border: 1px solid transparent;
      }
      .type-gofai          { background: #3d331f; color: #e3b341; }
      .type-fuzzy-match    { background: #3d2a1f; color: #f0883e; }
      .type-neural-net     { background: #1f3a5f; color: #58a6ff; }
      .type-template-match { background: #1f3d2f; color: #3fb950; }
      .type-keyword-match  { background: #1f3d3a; color: #39c5cf; }
      .type-embedding      { background: #2d1f3d; color: #bc8cff; }
      .type-llm            { background: #3d1f28; color: #ff7b72; }
      .type-ensemble       { background: #3d1f33; color: #ff9bce; }
      .type-transformer    { background: #1f3a5f; color: #79c0ff; }
      .type-default        { background: #21262d; color: #8b949e; }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--text);
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s, border-color 0.15s;
      }
      .btn:hover { background: rgba(255,255,255,0.05); border-color: var(--muted); text-decoration: none; color: var(--text); }
      .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .btn-primary {
        background: var(--gradient);
        color: #fff;
        border-color: transparent;
        font-weight: 700;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
      }
      .btn-primary:hover { filter: brightness(1.12); color: #fff; }

      footer {
        text-align: center;
        padding: 2.25rem 1.5rem;
        color: var(--muted);
        font-size: 0.85rem;
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        background: linear-gradient(180deg, transparent, rgba(31, 23, 25, 0.6));
      }
      footer p { margin-bottom: 0.5rem; }
      footer p:last-child { margin-bottom: 0; }

      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0);
        white-space: nowrap; border-width: 0;
      }

      @media (max-width: 640px) {
        header nav ul { gap: 1rem; }
        main { padding: 0 1rem; }
        h1 { font-size: 1.4rem; }
      }
    </style>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a class="logo" href={base}><span class="mark" aria-hidden="true">⚔️</span>OVOS Plugin Arena</a>
        <ul role="list">
          <li><a href={`${base}`}>Home</a></li>
          <li><a href={`${base}leaderboard/`}>Leaderboards</a></li>
          <li><a href={`${base}battle/`}>Battle</a></li>
          <li><a href={`${base}fighters/`}>Fighters</a></li>
          <li><a href="https://github.com/OpenVoiceOS/ovos-plugin-arena" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        OVOS Plugin Arena — <a href="https://github.com/OpenVoiceOS/ovos-plugin-arena">open source</a> ·
        Votes via GitHub Issues · Data refreshed hourly by GitHub Actions
      </p>
      <p>
        Funded by the <a href="https://nlnet.nl/project/OpenVoiceOS" rel="noopener noreferrer" target="_blank">NGI0 Commons Fund</a> /
        <a href="https://nlnet.nl" rel="noopener noreferrer" target="_blank">NLnet</a>
        under grant № <a href="https://cordis.europa.eu/project/id/101135429" rel="noopener noreferrer" target="_blank">101135429</a>,
        through the European Commission's <a href="https://ngi.eu" rel="noopener noreferrer" target="_blank">Next Generation Internet</a> programme.
      </p>
    </footer>
  </body>
</html>
